#!/usr/bin/env bash
# Hosted SDK provisioning only; every application test retains its own deadline.
set -euo pipefail
[[ $# -ge 2 ]] || { echo 'Usage: ci-sdk-install SDKMANAGER PACKAGE...' >&2; exit 2; }
sdk_manager=$1
shift
: "${ANDROID_HOME:?An explicit hosted SDK root is required}"
install_timeout=180s
for sdk_package in "$@"; do
    # Android 17 can take longer to unpack on a busy hosted disk.
    if [[ "$sdk_package" == 'system-images;android-37'* ]]; then install_timeout=300s; fi
done
for attempt in 1 2 3; do
    if timeout --kill-after=10s "$install_timeout" "$sdk_manager" --sdk_root="$ANDROID_HOME" "$@"; then
        exit 0
    else
        install_status=$?
    fi
    printf 'SDK installation attempt %s/3 failed with exit %s.\n' "$attempt" "$install_status" >&2
    if [[ "$attempt" != 3 ]]; then sleep 2; fi
done
exit "$install_status"
