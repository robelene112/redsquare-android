#!/usr/bin/env python3
"""Record actual target-process heap before any application acceptance tests."""
import argparse
import hashlib
import json
from pathlib import Path
import re
import shutil
import subprocess
import time

parser = argparse.ArgumentParser()
parser.add_argument("--evidence", type=Path, required=True)
parser.add_argument("--attempt", type=int, choices=range(1, 4), required=True)
parser.add_argument("--avd-config", type=Path, required=True)
args = parser.parse_args()
root = args.evidence / "runtime-preflight"
folder = root / f"boot-{args.attempt}"
assert folder.is_dir() and {p.name for p in folder.iterdir()} == {"emulator.log"}, "Require fresh per-boot log directory"
startup = (folder / "emulator.log").read_bytes()
assert startup, "Missing raw emulator startup log"
(folder / "startup.log").write_bytes(startup)
configuration = {"avd-config.ini": args.avd_config}
for name in ("emulator-capacity.txt", "system-image.txt", "system-image.properties",
             "system-build.txt", "device-abi.txt", "page-size.txt", "requested-page-size.txt"):
    configuration[name] = args.evidence / name
hashes = {}
for name, source in configuration.items():
    data = source.read_bytes()
    (folder / name).write_bytes(data)
    hashes[name] = hashlib.sha256(data).hexdigest()
    if args.attempt > 1:
        assert data == (root / "boot-1" / name).read_bytes(), f"Provisioning configuration changed: {name}"

properties = {}
for name in ("dalvik.vm.heapsize", "dalvik.vm.heapgrowthlimit", "ro.kernel.qemu.dalvik.vm.heapsize"):
    properties[name] = subprocess.check_output(["adb", "shell", "getprop", name], timeout=15, text=True).strip()
(folder / "properties.json").write_text(json.dumps(properties, indent=2) + "\n")
started = time.monotonic()
try:
    probe = subprocess.run(["adb", "shell", "am", "instrument", "-w", "-r",
        "-e", "class", "nl.davidengelen.redsquare.RuntimeHeapProbe",
        "nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60)
except subprocess.TimeoutExpired as failure:
    (folder / "probe.log").write_bytes(failure.output or b"")
    (folder / "probe-error.json").write_text(json.dumps({"result": "ERROR", "reason": "Probe timeout"}) + "\n")
    raise
(folder / "probe.log").write_bytes(probe.stdout)
text = probe.stdout.decode("utf-8")
observations = re.findall(r"^INSTRUMENTATION_STATUS: heapProbe=(.+)\r?$", text, re.M)
assert probe.returncode == 0 and len(observations) == 1, "Heap probe failed or observation missing"
assert re.findall(r"^INSTRUMENTATION_CODE: (-?\d+)\s*$", text, re.M) == ["-1"], "Heap probe did not complete"
assert "OK (1 test)" in text and "FAILURES!!!" not in text
assert "INSTRUMENTATION_STATUS: test=observesActualTargetProcessHeap" in text
observed = json.loads(observations[0])
assert observed["package"] == "nl.davidengelen.redsquare.dev" and observed["sdk"] == 29
assert observed["hardware"] in ("ranchu", "goldfish")
assert observed["pid"] > 0 and observed["parentPid"] > 0
assert observed["actualBytes"] > 0 and observed["declaredBytes"] > 0
valid = observed["actualBytes"] == observed["declaredBytes"]
record = dict(result="PASS" if valid else "INVALID_HEAP", attempt=args.attempt,
    maxAttempts=3, observation=observed, configurationSha256=hashes,
    emulatorStartupSha256=hashlib.sha256(startup).hexdigest(),
    probeSha256=hashlib.sha256(probe.stdout).hexdigest(), elapsedMillis=round((time.monotonic() - started) * 1000),
    qualification="One separate provisioning JUnit observation before acceptance tests, retained in.log outside their counts; unchanged heap settings, no service restart or application-assertion retry.")
(folder / "result.json").write_text(json.dumps(record, indent=2) + "\n")
print(json.dumps(record))
if valid:
    shutil.copyfile(folder / "result.json", root / "accepted.json")
raise SystemExit(0 if valid else 42)
