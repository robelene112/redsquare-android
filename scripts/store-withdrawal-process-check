#!/usr/bin/env python3
"""Actual manual Store withdrawal process loss, cold fresh-auth original retry and exact installation restore."""
import argparse
import json
from pathlib import Path
import subprocess
from process_check_utils import ProcessInstrumentation, assert_process_gone, finish_process_fixture

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--evidence', type=Path, required=True)
args = parser.parse_args()
package = 'nl.davidengelen.redsquare.dev'
checkpoint = 'cache/store-withdrawal-process-checkpoint.json'

def adb(*arguments, check=True, timeout=60):
    return subprocess.run(['adb', *arguments], capture_output=True, text=True, check=check, timeout=timeout)

instrument = ProcessInstrumentation(adb, args.evidence, 'nl.davidengelen.redsquare.StoreWithdrawalProcessRecoveryTest',
                                    package + '.test/androidx.test.runner.AndroidJUnitRunner').run
assert adb('get-serialno').stdout.strip().startswith('emulator-'), 'Require isolated emulator'
args.evidence.mkdir(parents=True, exist_ok=True)
primary = None
try:
    result = instrument('terminateAfterAnAuthenticatedWithdrawalWithUnknownAvailability', 'interrupted.txt', check=False)
    assert 'FAILURES!!!' not in result.stdout, 'Preparation failed before deliberate termination'
    row = json.loads(adb('exec-out', 'run-as', package, 'cat', checkpoint).stdout)
    assert row['phase'] == 'pending' and row['backend'] == 'owner' and row['candidate']
    assert_process_gone(adb, package, row['pid'])
    (args.evidence / 'pending-checkpoint.json').write_text(json.dumps(row, indent=2) + '\n')
    adb('shell', 'am', 'force-stop', package)
    result = instrument('coldWithdrawalRequiresFreshAuthorizationAndRetriesOnlyOriginal', 'recovered.txt')
    assert 'OK (1 test)' in result.stdout, 'Cold native Store withdrawal recovery failed'
    recovered = json.loads(adb('exec-out', 'run-as', package, 'cat', checkpoint).stdout)
    assert recovered == dict(row, phase='recovered', recoveredPid=recovered['recoveredPid'])
    assert isinstance(recovered['recoveredPid'], int) and recovered['recoveredPid'] > 0 and recovered['recoveredPid'] != row['pid']
    (args.evidence / 'recovered-checkpoint.json').write_text(json.dumps(recovered, indent=2) + '\n')
    (args.evidence / 'continuity.txt').write_text('PASS: actual authenticated native Store manual withdrawal before process death, '
        'cold no automatic resend, fresh real device authentication, exact retained original request, no replacement quote or externally paid claim, '
        'wallet/node and unsent Chat/retained Fileshare state preserved.\n')
except BaseException as failure:
    primary = failure
    raise
finally:
    adb('shell', 'locksettings', 'clear', '--old', '246813', '--user', '0', check=False)
    finish_process_fixture(instrument, args.evidence, package, 'store-withdrawal-process-evidence', primary)
