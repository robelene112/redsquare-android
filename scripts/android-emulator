#!/usr/bin/env bash
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
case "${1:-29}" in
    29) system_image='system-images;android-29;default;x86_64' ;;
    37.0) system_image='system-images;android-37.0;google_apis;x86_64' ;;
    *) echo 'Supported diagnostic targets: 29 or 37.0' >&2; exit 2 ;;
esac
image=redsquare-android-emulator:api29-api37
if ! docker image inspect "$image" >/dev/null 2>&1; then
    docker build --memory=1g -f "$repo_dir/build-support/Emulator.Dockerfile" -t "$image" "$repo_dir/build-support"
fi
mkdir -p "$repo_dir/.scratch/device-evidence"
docker run --rm --cpus=2 --memory=2500m --network none \
    --user "$(id -u):$(id -g)" \
    -e "TEST_SYSTEM_IMAGE=$system_image" -e "TEST_DEVICE_API=${1:-29}" \
    --mount "type=bind,src=$repo_dir,dst=/workspace" \
    "$image" /workspace/scripts/emulator-check
