#!/usr/bin/env python3
"""Verify cold personal-controls recovery after an actual app process death, without resetting its identity."""
import argparse
import json
from pathlib import Path
import re
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--evidence', type=Path, required=True)
args = parser.parse_args()
package = 'nl.davidengelen.redsquare.dev'
runner = package + '.test/androidx.test.runner.AndroidJUnitRunner'
test_class = 'nl.davidengelen.redsquare.PersonalControlsProcessRecoveryTest'
checkpoint = 'cache/personal-controls-process-checkpoint.json'


def adb(*arguments, check=True, timeout=60):
    return subprocess.run(['adb', *arguments], capture_output=True, text=True, check=check, timeout=timeout)


def instrument(name, filename, check=True):
    try:
        result = adb('shell', 'am', 'instrument', '-w', '-r', '-e', 'class',
                     test_class + '#' + name, runner, check=check, timeout=120)
        (args.evidence / filename).write_text(result.stdout + result.stderr)
        return result
    except (subprocess.TimeoutExpired, subprocess.CalledProcessError) as error:
        def decoded(value):
            return value.decode('utf-8', errors='replace') if isinstance(value, bytes) else (value or '')
        (args.evidence / filename).write_text(decoded(error.stdout) + decoded(error.stderr))
        raise


if not adb('get-serialno').stdout.strip().startswith('emulator-'):
    raise SystemExit('This check requires an isolated emulator')
args.evidence.mkdir(parents=True, exist_ok=True)
adb('shell', 'run-as', package, 'rm', '-f', checkpoint)
try:
    result = instrument('terminateDuringAnUnmuteCommit', 'interrupted.txt', check=False)
    if 'FAILURES!!!' in result.stdout:
        raise AssertionError('Personal choices failed before deliberate process termination')
    row = json.loads(adb('exec-out', 'run-as', package, 'cat', checkpoint).stdout)
    if row['phase'] != 'pending' or row['backend'] != 'owner':
        raise AssertionError('Missing pending personal-controls checkpoint')
    for name in ('owner', 'muted', 'blocked'):
        if not re.fullmatch(r'[1-9A-HJ-NP-Za-km-z]{43,45}', row[name]):
            raise AssertionError('Invalid public personal-controls account')
    if row['muted'] == row['blocked']:
        raise AssertionError('Mute and Block require distinct fixture accounts')
    # Metadata only: encrypted policy and private wallet contents are never read or retained.
    guard = 'no_backup/personal.' + row['owner'] + '.guard.v1'
    if adb('shell', 'run-as', package, 'test', '-s', guard, check=False).returncode != 0:
        raise AssertionError('Termination did not leave a durable pending old-policy guard')
    if not isinstance(row['pid'], int) or row['pid'] <= 0:
        raise AssertionError('Invalid original Personal-controls process ID')
    if str(row['pid']) in adb('shell', 'pidof', package, check=False).stdout.split():
        raise AssertionError('Personal-controls process was not actually terminated')
    (args.evidence / 'pending-checkpoint.json').write_text(json.dumps(row, indent=2) + '\n')
    adb('shell', 'am', 'force-stop', package)
    result = instrument('coldRecoveryRetainsMuteAndBlockBeforeExplicitRemoval', 'recovered.txt')
    if 'OK (1 test)' not in result.stdout:
        raise AssertionError('Cold personal-controls recovery did not pass')
    recovered = json.loads(adb('exec-out', 'run-as', package, 'cat', checkpoint).stdout)
    if recovered != dict(row, phase='recovered', recoveredPid=recovered['recoveredPid']):
        raise AssertionError('Cold personal-controls recovery changed its public checkpoint')
    if (not isinstance(recovered['recoveredPid'], int) or recovered['recoveredPid'] <= 0 or
            recovered['recoveredPid'] == row['pid']):
        raise AssertionError('Recovery did not use a new process')
    # Android stops the target when instrumentation finishes; the native phase
    # asserts Process.myPid() before completion and writes that actual ID here.
    (args.evidence / 'recovered-checkpoint.json').write_text(json.dumps(recovered, indent=2) + '\n')
    (args.evidence / 'continuity.txt').write_text(
        'PASS: actual pending-save process death, verified surviving encrypted guard metadata, '
        'same wallet/backend without recovery reset, cold Mute and independent Block recovery, '
        'explicit Unblock retains Mute, explicit Unmute restores cached post, zero transactions.\n')
    print('PASS: cold personal-controls recovery')
finally:
    # Best-effort capture cannot replace the original failure.
    try:
        with (args.evidence / 'images.tar').open('wb') as output:
            capture = subprocess.run(['adb', 'exec-out', 'run-as', package, 'tar', '-C', 'cache',
                                      '-cf', '-', 'personal-controls-process-evidence'], stdout=output,
                                     stderr=subprocess.PIPE, timeout=10)
        (args.evidence / 'capture-status.txt').write_text(str(capture.returncode) + '\n' +
                                                        capture.stderr.decode('utf-8', errors='replace'))
    except (OSError, subprocess.TimeoutExpired) as failure:
        try:
            (args.evidence / 'capture-status.txt').write_text('Synthetic evidence capture failed: ' + str(failure))
        except OSError:
            pass  # Even failed diagnostic storage must preserve the primary failure.
