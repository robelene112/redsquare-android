#!/usr/bin/env python3
"""Cold native call recovery after actual camera capture and process death, on an isolated emulator."""
import argparse
import json
from pathlib import Path
import subprocess
from process_check_utils import ProcessInstrumentation, assert_process_gone, finish_process_fixture

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--evidence', type=Path, required=True)
args = parser.parse_args()
package = 'nl.davidengelen.redsquare.dev'
checkpoint = 'cache/talk-process-checkpoint.json'


def adb(*arguments, check=True, timeout=60):
    return subprocess.run(['adb', *arguments], capture_output=True, text=True, check=check, timeout=timeout)


instrument = ProcessInstrumentation(adb, args.evidence, 'nl.davidengelen.redsquare.TalkProcessRecoveryTest',
                                    package + '.test/androidx.test.runner.AndroidJUnitRunner').run
assert adb('get-serialno').stdout.strip().startswith('emulator-'), 'Require isolated emulator'
args.evidence.mkdir(parents=True, exist_ok=True)
primary = None
permissions = ['RECORD_AUDIO', 'CAMERA']
if int(adb('shell', 'getprop', 'ro.build.version.sdk').stdout.strip()) >= 33:
    permissions.append('POST_NOTIFICATIONS')
original_permissions = adb('shell', 'dumpsys', 'package', package).stdout
try:
    for permission in permissions:
        adb('shell', 'pm', 'grant', package, 'android.permission.' + permission)
    result = instrument('terminateDuringActualCameraCaptureAndForegroundCall', 'interrupted.txt', check=False)
    assert 'FAILURES!!!' not in result.stdout, 'Preparation failed before deliberate termination'
    row = json.loads(adb('exec-out', 'run-as', package, 'cat', checkpoint).stdout)
    assert row['phase'] == 'pending' and row['backend'] in ('owner', 'official')
    assert row['cameraFrames'] >= 3 and row['token']
    assert_process_gone(adb, package, row['pid'])
    (args.evidence / 'pending-checkpoint.json').write_text(json.dumps(row, indent=2) + '\n')
    adb('shell', 'am', 'force-stop', package)
    result = instrument('coldRestartRejectsTheOldCallReturnWithoutCaptureAndRetainsTheDraft', 'recovered.txt')
    assert 'OK (1 test)' in result.stdout, 'Cold call recovery failed'
    recovered = json.loads(adb('exec-out', 'run-as', package, 'cat', checkpoint).stdout)
    assert recovered == dict(row, phase='recovered', recoveredPid=recovered['recoveredPid'])
    assert isinstance(recovered['recoveredPid'], int) and recovered['recoveredPid'] > 0 and recovered['recoveredPid'] != row['pid']
    (args.evidence / 'recovered-checkpoint.json').write_text(json.dumps(recovered, indent=2) + '\n')
    (args.evidence / 'continuity.txt').write_text('PASS: actual process death during camera capture and foreground call, '
        'cold native expired-call feedback, no capture or signalling restart, exact wallet and unsent draft retained.\n')
except BaseException as failure:
    primary = failure
    raise
finally:
    try:
        finish_process_fixture(instrument, args.evidence, package, 'talk-process-evidence', primary)
    finally:
        for permission in permissions:
            if 'android.permission.' + permission + ': granted=true' not in original_permissions:
                adb('shell', 'pm', 'revoke', package, 'android.permission.' + permission)
