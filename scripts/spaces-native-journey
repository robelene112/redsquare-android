repo = Path(__file__).resolve().parent.parent
mode = sys.argv[2] if len(sys.argv) == 3 else 'journey-v1'
if len(sys.argv) not in (2, 3) or mode not in ('journey-v1', 'voice-room-v1', 'voice-room-crossed-v1', 'catch-up-v1', 'visual-v1', 'moderation-v1', 'file-library-v1', 'article-channels-v1', 'protected-chat-v1', 'conversation-overlays-v1', 'discovery-v1', 'management-v1', 'private-management-v1', 'private-readiness-v1', 'category-management-v1', 'governance-v1', 'membership-v1', 'private-ownership-v1') or (len(sys.argv) == 3 and mode == 'journey-v1'):
    raise ValueError('Expected evidence directory and an optional supported Spaces journey mode')
file_mode = mode == 'file-library-v1'
crossed_room = mode == 'voice-room-crossed-v1'
room_mode = mode == 'voice-room-v1' or crossed_room
visual_mode = mode == 'visual-v1'
catch_up_mode = mode == 'catch-up-v1' or visual_mode
accessibility_mode = os.environ.get('SPACES_ACCESSIBILITY') == 'true'
if accessibility_mode and mode not in ('catch-up-v1', 'file-library-v1', 'voice-room-v1'):
    raise ValueError('TalkBack requires an owned catch-up, library or room fixture')
moderation_mode = mode == 'moderation-v1'
article_mode = mode == 'article-channels-v1'
conversation_overlays_mode = mode == 'conversation-overlays-v1'
private_ownership_mode = mode == 'private-ownership-v1'
membership_mode = private_ownership_mode or mode == 'membership-v1'
governance_mode = mode == 'governance-v1'
category_access_mode = governance_mode and os.environ.get('SPACES_PRIVATE_MANAGEMENT_CASE') == 'category-access'
startup_trace = os.environ.get('SPACES_STARTUP_TRACE') == 'true'
if startup_trace and not category_access_mode:
    raise ValueError('Initial-history sampling requires the isolated category-access journey')
category_management_mode = mode == 'category-management-v1'
discovery_mode = mode == 'discovery-v1'
private_management_mode = mode == 'private-management-v1'
private_readiness_mode = mode == 'private-readiness-v1'
management_mode = mode in ('management-v1', 'private-management-v1', 'private-readiness-v1', 'category-management-v1', 'governance-v1', 'membership-v1', 'private-ownership-v1')
community_mode = discovery_mode or management_mode
label = 'visual' if visual_mode else 'catch-up' if catch_up_mode else 'moderation' if moderation_mode else 'room-crossed' if crossed_room else 'rooms' if room_mode else 'files' if file_mode else 'articles' if article_mode else 'private-ownership' if private_ownership_mode else 'membership' if membership_mode else 'governance' if governance_mode else 'category-management' if category_management_mode else 'private-readiness' if private_readiness_mode else 'private-management' if private_management_mode else 'management' if management_mode else 'discovery' if discovery_mode else 'journey'
folder = 'spaces-catch-up-evidence' if visual_mode else 'spaces-rooms-evidence' if crossed_room else f'spaces-{label}-evidence'
checkpoint_name = f'spaces-{label}-checkpoint.json'
classname = 'SpacesCatchUpJourneyTest' if catch_up_mode else 'SpaceModerationJourneyTest' if moderation_mode else 'SpaceRoomJourneyTest' if room_mode else 'SpaceFileJourneyTest' if file_mode else 'SpaceArticleJourneyTest' if article_mode else 'SpacesManagementJourneyTest' if management_mode else 'SpacesDiscoveryJourneyTest' if discovery_mode else 'SpacesJourneyTest'
evidence = Path(sys.argv[1]).resolve() / f'spaces-{label}'
evidence.mkdir(parents=True, exist_ok=False)
pkg = 'nl.davidengelen.redsquare.dev'
runner = pkg + '.test/androidx.test.runner.AndroidJUnitRunner'
children = []

def adb(*args, timeout=15, check=True):
    return subprocess.run(['adb', *args], capture_output=True, timeout=timeout, check=check)

def command(port, action, payload=None):
    request = urllib.request.Request(f'http://127.0.0.1:{port}/{action}', json.dumps(payload or {}).encode(), {'Content-Type': 'application/json'})
    with urllib.request.urlopen(request, timeout=5) as response:
        return json.load(response)

def instrument(method, filename, peer, control, extra=(), test_class=classname):
    log = (evidence / filename).open('wb')
    process = subprocess.Popen(['adb', 'shell', 'am', 'instrument', '-w', '-r',
        '-e', 'class', f'nl.davidengelen.redsquare.{test_class}#{method}',
        '-e', 'spacesPeerPort', str(peer), '-e', 'spacesControlPort', str(control)] +
        (['-e', 'spacesFileCertificate', file_certificate] if file_mode else []) +
        (['-e', 'spacesDisposableBaseline', 'true'] if management_mode else []) +
        (['-e', 'spacesPrivateManagement', 'true'] if private_management_mode else []) +
        (['-e', 'spacesPrivateReadiness', 'true'] if private_readiness_mode else []) +
        (['-e', 'spacesCategoryManagement', 'true'] if category_management_mode else []) +
        (['-e', 'spacesMembership', 'true'] if membership_mode else []) +
        (['-e', 'spacesPrivateOwnership', 'true'] if private_ownership_mode else []) +
        (['-e', 'spacesGovernance', 'true'] if governance_mode else []) +
        (['-e', 'spacesCategoryAccess', 'true'] if category_access_mode else []) +
        (['-e', 'spacesStartupTrace', 'true'] if startup_trace else []) + [*extra, runner],
        stdout=log, stderr=subprocess.STDOUT)
    children.append((process, log))
    return process

control_port = None
reverses = []
file_certificate = None
movies = []
movie_owners = {}
viewport_original = None
visual_settings = None
room_rotation_original = None
owned_emulator = False
article_agreement_owned = False

def viewport_observation(stage, expected=None):
    args = ['shell', 'am', 'instrument', '-w', '-r', '-e', 'class',
        'nl.davidengelen.redsquare.SpacesViewportConfigurationTest#observeOwnedConfiguration',
        '-e', 'spacesViewportStage', stage]
    for name, value in (expected or {}).items():
        args += ['-e', name, str(value)]
    if management_mode or article_mode or file_mode or room_mode or moderation_mode or catch_up_mode:
        args += ['-e', 'spacesViewportFolder', folder]
    observed = adb(*args, runner, timeout=30, check=False)
    text = observed.stdout.decode(errors='replace')
    (evidence / f'viewport-{stage}-probe.txt').write_bytes(observed.stdout + observed.stderr)
    if observed.returncode or len(re.findall(r'^OK \(1 test\)\s*$', text, re.M)) != 1:
        raise RuntimeError(f'Actual viewport {stage} resource probe failed')
    value = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/viewport-{stage}.json').stdout)
    (evidence / f'viewport-{stage}-resources.json').write_text(json.dumps(value, indent=2))
    return value

def viewport_override(kind):
    text = adb('shell', 'wm', kind).stdout.decode().strip()
    pattern = r'[0-9]+x[0-9]+' if kind == 'size' else r'[0-9]+'
    physical = re.findall(r'Physical ' + kind + ': (' + pattern + ')', text)
    override = re.findall(r'Override ' + kind + ': (' + pattern + ')', text)
    if len(physical) != 1 or len(override) > 1:
        raise RuntimeError('Unrecognized actual viewport setting')
    return {'physical': physical[0], 'override': override[0] if override else None}

def prepare_viewport():
    global viewport_original
    # Capture every original before the first mutation. Separate resource probes
    # observe the actual Android configuration, not a shell command's intent.
    original = {'size': viewport_override('size'), 'density': viewport_override('density'),
        'fontSetting': adb('shell', 'settings', 'get', 'system', 'font_scale').stdout.decode().strip()}
    if not re.fullmatch(r'null|[0-9]+(?:\.[0-9]+)?', original['fontSetting']):
        raise RuntimeError('Unrecognized original font setting')
    (evidence / 'viewport-original.json').write_text(json.dumps(original, indent=2))
    original['resources'] = viewport_observation('baseline')
    viewport_original = original
    (evidence / 'viewport-original.json').write_text(json.dumps(viewport_original, indent=2))
    adb('shell', 'am', 'force-stop', pkg)
    adb('shell', 'wm', 'size', '640x1280')
    adb('shell', 'wm', 'density', '320')
    adb('shell', 'settings', 'put', 'system', 'font_scale', '2.0')
    viewport_observation('prepared', {'spacesExpectedFont': 2.0, 'spacesExpectedWidth': 320, 'spacesExpectedDensity': 320})
    if viewport_override('size')['override'] != '640x1280' or viewport_override('density')['override'] != '320':
        raise RuntimeError('Owned compact viewport did not apply')
    deadline = time.monotonic() + 10
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0: raise RuntimeError('Compact compositor dimensions did not settle within10s')
        png = adb('exec-out', 'screencap', '-p', timeout=min(5, remaining)).stdout
        (evidence / 'viewport-prepared.png').write_bytes(png)
        if png.startswith(b'\x89PNG\r\n\x1a\n') and struct.unpack('>II', png[16:24]) == (640, 1280): break
        time.sleep(.05)

def verify_restored_viewport():
    original = viewport_original
    resources = original['resources']
    observed = viewport_observation('restored', {'spacesExpectedFont': resources['fontScale'],
        'spacesExpectedWidth': resources['screenWidthDp'], 'spacesExpectedDensity': resources['densityDpi']})
    size, density = viewport_override('size'), viewport_override('density')
    implicit = (resources['sdk'] == 29 and original['fontSetting'] == 'null' and resources['fontScale'] == 1.0 and observed['fontSetting'] == '1.0')
    result = {'size': size, 'density': density, 'fontSetting': observed['fontSetting'], 'implicitAndroid10Default': implicit}
    (evidence / 'viewport-restoration.json').write_text(json.dumps(result, indent=2))
    if size != original['size'] or density != original['density'] or not (observed['fontSetting'] == original['fontSetting'] or implicit):
        raise RuntimeError('Original viewport configuration was not restored')

def reset_disposable_baseline():
    # Android 10 can finish package-manager cleanup after the old process exits.
    # This is provisioning, before any journey or interaction deadline starts.
    reset = adb('shell', 'pm', 'clear', pkg, timeout=30)
    if reset.stdout.strip() != b'Success': raise RuntimeError('Disposable dev baseline was not cleared')
    (evidence / 'disposable-baseline.json').write_text(json.dumps({'package': pkg, 'serial': serial,
        'clearExit': reset.returncode, 'ordinaryPackageTouched': False}))

try:
    serial = adb('get-serialno').stdout.decode().strip()
    if not serial.startswith('emulator-'):
        raise RuntimeError('Only a disposable emulator may run this fixture')
    owned_emulator = True
    classpath = (repo / 'spaces-service/build/host-fixture-classpath.txt').read_text().strip()
    native = repo / 'core/build/generated/spaces-mls-host'
    hostroot = repo / '.scratch' / ((f'spaces-{label}-host-' if community_mode or article_mode or file_mode or room_mode or moderation_mode or catch_up_mode else 'spaces-native-host-') + os.environ['TEST_DEVICE_API'])
    hostroot.mkdir(parents=True, exist_ok=False)
    if file_mode:
        store = hostroot / 'files-fixture.p12'
        certificate = hostroot / 'files-fixture.cer'
        subprocess.run(['keytool', '-genkeypair', '-keyalg', 'RSA', '-keysize', '2048',
            '-validity', '1', '-dname', 'CN=127.0.0.1', '-ext', 'SAN=IP:127.0.0.1', '-alias', 'owned-provider',
            '-storetype', 'PKCS12', '-storepass', 'owned-fixture', '-keystore', str(store)],
            check=True, capture_output=True, timeout=20)
        subprocess.run(['keytool', '-exportcert', '-alias', 'owned-provider', '-storepass',
            'owned-fixture', '-keystore', str(store), '-file', str(certificate)],
            check=True, capture_output=True, timeout=10)
        file_certificate = base64.b64encode(certificate.read_bytes()).decode('ascii')
    hostlog = (hostroot / 'host.log').open('wb')
    host = subprocess.Popen(['java', '-Xmx512m', f'-Djava.library.path={native}', '-cp', classpath,
        'nl.davidengelen.redsquare.spaces.service.SpacesNativeHost', str(hostroot)] + (['catch-up-v1' if visual_mode else 'voice-room-v1' if crossed_room else mode] if community_mode or conversation_overlays_mode or article_mode or file_mode or room_mode or moderation_mode or catch_up_mode else []), stdout=hostlog, stderr=subprocess.STDOUT)
    children.append((host, hostlog))
    deadline = time.monotonic() + 30
    while not (hostroot / 'ready.json').exists():
        if host.poll() is not None:
            raise RuntimeError('Owned Spaces host stopped before readiness; inspect host-host.log')
        if time.monotonic() >= deadline:
            raise RuntimeError('Owned Spaces host did not become ready within 30 seconds')
        time.sleep(.1)
    ready = json.loads((hostroot / 'ready.json').read_text())
    peer_port, control_port = ready['peerPort'], ready['controlPort']
    for port in [peer_port, control_port] + ([ready['providerPort']] if file_mode else []):
        adb('reverse', f'tcp:{port}', f'tcp:{port}')
        reverses.append(port)
    # One unbroken movie per phase. Native goals stay bounded independently.
    def record(phase, size=None):
        remote = f'/sdcard/spaces-{label}-{phase}.mp4'
        logfile = (evidence / f'movie-{phase}.log').open('wb')
        options = ['--size', size] if size else []
        process = subprocess.Popen(['adb', 'shell', '-n', 'screenrecord', '--time-limit', '180',
            '--bit-rate', '2000000', *options, remote], stdin=subprocess.DEVNULL, stdout=logfile, stderr=subprocess.STDOUT)
        children.append((process, logfile)); movies.append((process, remote, phase))
        deadline = time.monotonic() + 5
        def provision_probe(*args):
            remaining = deadline - time.monotonic()
            if remaining <= 0: raise RuntimeError('Owned recorder did not start within5s')
            return adb(*args, timeout=min(2, remaining), check=False)
        while True:
            observed = provision_probe('shell', 'pidof', 'screenrecord')
            matches = []
            for raw in observed.stdout.split():
                if not raw.isdigit(): raise RuntimeError('Recorder PID observation was not numeric')
                pid = int(raw)
                commandline = provision_probe('shell', 'cat', f'/proc/{pid}/cmdline')
                args = commandline.stdout.split(b'\0')
                if commandline.returncode == 0 and remote.encode() in args and args[0].endswith(b'screenrecord'):
                    matches.append(pid)
            if len(matches) > 1: raise RuntimeError('More than one owned recorder has this phase path')
            if matches:
                if process.poll() is not None or time.monotonic() >= deadline:
                    raise RuntimeError('Owned recorder ended or exceeded5s before readiness')
                movie_owners[phase] = {'pid': matches[0], 'remote': remote, 'started': True}
                if size:
                    movie_owners[phase]['encodedSize'] = size
                (evidence / f'recorder-{phase}.json').write_text(json.dumps(movie_owners[phase]))
                return process
            if process.poll() is not None or time.monotonic() >= deadline:
                raise RuntimeError('Owned recorder did not start within5s')
            time.sleep(.05)

    def finish_record(process, remote, phase):
        deadline = time.monotonic() + 15
        owner = movie_owners.get(phase)
        if owner is None: raise RuntimeError('Recorder has no verified owned PID')
        def probe(*args):
            remaining = deadline - time.monotonic()
            if remaining <= 0: raise subprocess.TimeoutExpired(process.args, 15)
            return adb(*args, timeout=min(5, remaining), check=False)
        def device_state():
            observed = probe('shell', 'cat', f'/proc/{owner["pid"]}/cmdline')
            if observed.returncode == 0:
                args = observed.stdout.split(b'\0')
                return 'owned' if remote.encode() in args and args[0].endswith(b'screenrecord') else 'reused'
            exists = probe('shell', 'test', '-d', f'/proc/{owner["pid"]}')
            if exists.returncode == 1 and not exists.stdout and not exists.stderr: return 'gone'
            raise RuntimeError('Could not verify the owned device recorder identity')
        before = device_state()
        owner['deviceBeforeStop'] = before
        if before == 'owned':
            signal = probe('shell', 'kill', '-2', str(owner['pid']))
            owner['signalExit'] = signal.returncode
            owner['signalStdout'] = signal.stdout.decode(errors='replace')
            owner['signalStderr'] = signal.stderr.decode(errors='replace')
            (evidence / f'recorder-{phase}.json').write_text(json.dumps(owner))
            if signal.returncode != 0 and device_state() == 'owned':
                raise RuntimeError('Owned recorder refused SIGINT')
        after = device_state()
        while after == 'owned':
            if time.monotonic() >= deadline: raise subprocess.TimeoutExpired(process.args, 15)
            time.sleep(.05); after = device_state()
        owner['deviceAfterStop'] = after
        remaining = deadline - time.monotonic()
        if remaining <= 0: raise subprocess.TimeoutExpired(process.args, 15)
        process.wait(timeout=remaining)
        owner['transportExit'] = process.returncode
        (evidence / f'recorder-{phase}.json').write_text(json.dumps(owner))
        if process.returncode != 0 or time.monotonic() >= deadline:
            raise RuntimeError('Recorder transport did not complete successfully within15s')
        owner['stopped'] = True
        (evidence / f'recorder-{phase}.json').write_text(json.dumps(owner))
    if management_mode:
        contract = adb('shell', 'am', 'instrument', '-w', '-r', '-e', 'class',
            'nl.davidengelen.redsquare.SpaceMlsRuntimeTest#concurrentAccountStoresWaitForTheSameEncryptedTransactionAndKeepCommittedRows',
            runner, timeout=30, check=False)
        (evidence / 'store-concurrency-contract.txt').write_bytes(contract.stdout + contract.stderr)
        contract_text = contract.stdout.decode(errors='replace')
        if contract.returncode or len(re.findall(r'^OK \(1 test\)\s*$', contract_text, re.M)) != 1:
            raise RuntimeError('Actual encrypted-store concurrency contract failed')
        storage = json.loads(adb('exec-out', 'run-as', pkg, 'cat', 'cache/spaces-store-concurrency.json').stdout)
        (evidence / 'store-concurrency-contract.json').write_text(json.dumps(storage, indent=2))
        if storage['package'] != pkg or storage['readerBlockedUntilCommit'] is not True or storage['ownedCleanupComplete'] is not True:
            raise RuntimeError('Encrypted-store contract scope or cleanup differs')
    if community_mode:
        # Freeze the whole selected journey before the first measurement.
        if membership_mode:
            phases = [
                ('ownerReviewsBanAndCheckpointsTheActuallyAcceptedOriginal', 'membership-ban'),
                ('coldBanRecoveryAndBothOwnershipPartiesCheckpointARealAcceptance', 'membership-accept'),
                ('coldOwnershipAcceptanceKeepsItsOriginalAndBothActualRoles', None),
                ('compactOwnershipAndFormerOwnerDepartureUseTheActualMembershipControls', None),
            ]
            goals = {'version': 1, 'mode': mode, 'phases': phases,
                'executionScope': 'public-membership-and-two-party-ownership',
                'phaseSeconds': 180, 'actionSeconds': 5, 'contentSeconds': 15, 'combinedRecoverySeconds': 27,
                'minimumControlDp': 48, 'nativeTerminalPasses': 2, 'deliberatelyInterruptedCases': 2,
                'distinctPids': 4, 'lostAcceptedReplies': ['ban-member', 'accept-owner'],
                'exactOriginalAttempts': 2, 'originalAttempts': 14, 'uniqueOriginals': 12,
                'publicMembershipNativeCoverage': True, 'publicOwnershipNativeCoverage': True,
                'privateOwnershipNativeCoverage': False, 'capturePairs': 14, 'controlGeometryRecords': 42,
                'protectedReadingRecords': ['membership-before', 'membership-restored'],
                'viewport': {'widthDp': 320, 'fontScale': 2.0, 'densityDpi': 320, 'resourceProbes': 3},
                'productionNodeActivated': False, 'ordinaryBetaChanged': False}
            if private_ownership_mode:
                goals.update(executionScope='public-community-private-channel-ownership', privateOwnershipNativeCoverage=True,
                    capturePairs=15, controlGeometryRecords=46, privateContentWaitSeconds=15,
                    actualSuccessorPrivateHistory=True, originalPrivateMessage='An earlier private ownership conversation')
            reset_disposable_baseline()
        elif governance_mode:
            phases = [
                ('privateCategoryCheckpointsItsActualPendingOriginalAfterClosingTheSpace', 'governance-category'),
                ('coldPrivateCategoryRecoversItsOriginalAndReviewsUnlistedPublicOpening', None),
                ('compactPrivateCategoryAndDissolutionKeepRealControlsAndCheckpointTheRequest', 'governance-dissolution'),
                ('coldClosedSpaceRetainsItsDraftAndShowsNoJoinToAnotherIdentity', None),
            ]
            goals = {'version': 1, 'mode': mode, 'phases': phases,
                'executionScope': 'private-category-process-visibility-and-terminal-lifecycle',
                'phaseSeconds': 180, 'actionSeconds': 5, 'contentSeconds': 15, 'combinedRecoverySeconds': 27,
                'minimumControlDp': 48, 'nativeTerminalPasses': 2, 'deliberatelyInterruptedCases': 2,
                'distinctPids': 4, 'pendingOperationProcessRecovery': True, 'privateCategoryNativeCoverage': True,
                'lostAcceptedReplies': ['create-category', 'dissolve'], 'exactOriginalAttempts': 2,
                'categoryCount': 1, 'acceptedGovernanceControls': 5, 'governanceOriginalAttempts': 7,
                'privateCategoryNames': ['Native private conversations', 'Compact private conversations'],
                'confirmedVisibilitySequence': ['PRIVATE', 'PUBLIC'], 'publicOpeningListed': False,
                'discoverableDefaultChecked': True, 'closedOtherIdentity': True, 'savedDraftPreserved': True,
                'publicArchiveControlsFollowVisibility': True,
                'protectedReadingRecords': ['governance-normal-before', 'governance-normal-restored',
                    'governance-normal-public', 'governance-compact-before', 'governance-compact-closed'],
                'focusedFieldsFullyVisible': 2, 'focusedFieldsRequireIme': True, 'activityRecreations': 1,
                'capturePairs': 15, 'controlGeometryMinimum': 30, 'controlGeometryMaximum': 31,
                'conditionalSavedCommunityCard': True,
                'viewport': {'widthDp': 320, 'fontScale': 2.0, 'densityDpi': 320, 'resourceProbes': 3},
                'membershipOwnershipNativeCoverage': False,
                'productionNodeActivated': False, 'ordinaryBetaChanged': False}
            if category_access_mode:
                goals.update(privateCategorySelectionBridge=True, privateCategoryCreates=1, privateCategoryEdits=1,
                    restrictedOffClearsPrivateCategory=True, activityRecreations=4, capturePairs=21,
                    controlGeometryMinimum=46, controlGeometryMaximum=47,
                    acceptedGovernanceControls=7, governanceOriginalAttempts=9)
                goals['protectedReadingRecords'].insert(4, 'governance-private-category-return')
            reset_disposable_baseline()
        elif category_management_mode:
            phases = [
                ('categoryEditorRestoresItsDraftAndRecoversAnActuallyUnconfirmedCreation', None),
                ('compactCategoryEditorKeepsItsRealImeAndSaveRecoveryReachable', None),
            ]
            goals = {'version': 1, 'mode': mode, 'phases': phases,
                'executionScope': 'public-category-editor-first-feedback-only',
                'phaseSeconds': 180, 'actionSeconds': 5, 'contentSeconds': 15, 'minimumControlDp': 48,
                'combinedRecoverySeconds': 27, 'nativeTerminalPasses': 2, 'deliberatelyInterruptedCases': 0,
                'pendingOperationProcessRecovery': False, 'privateCategoryNativeCoverage': False,
                'activityRecreations': 2, 'focusedFieldsFullyVisible': 2, 'focusedFieldsRequireIme': True,
                'localWriteFailureCases': ['category-normal', 'category-compact'],
                'dismissLocalErrorRemainsEditable': True, 'pendingCreationBackWithoutDiscard': True,
                'lostAcceptedReplies': ['create-category', 'edit-category'], 'exactOriginalAttempts': 2,
                'categoryCount': 1, 'categoryOriginalAttempts': 4, 'channelAssignmentOriginals': 1,
                'stableChannelCategory': True, 'nativeDrawerCategoryChecks': 2, 'preservedGeneralDraftAndPixel': True,
                'viewport': {'widthDp': 320, 'fontScale': 2.0, 'densityDpi': 320, 'resourceProbes': 3},
                'productionNodeActivated': False, 'ordinaryBetaChanged': False}
            reset_disposable_baseline()
        elif private_readiness_mode:
            phases = [
                ('waitingAdministratorCanGrantButCannotRemoveAndRecoversAnActuallyRejectedGrant', None),
                ('compactWaitingAdministratorSeesARealRejectionAndExplicitlyRecovers', None),
            ]
            goals = {'version': 1, 'mode': mode, 'phases': phases,
                'executionScope': 'key-unavailable-administration-and-genuine-rejection-recovery',
                'phaseSeconds': 180, 'actionSeconds': 5, 'contentSeconds': 15, 'minimumControlDp': 48,
                'nativeTerminalPasses': 2, 'deliberatelyInterruptedCases': 0,
                'privateKeys': 'independent-holder-only-after-actual-native-reader-removal',
                'disabledRemoval': True, 'enabledPolicyGrant': True,
                'genuineRejections': 2, 'explicitFreshIntentRecovery': True, 'grantOriginals': 5,
                'viewport': {'widthDp': 320, 'fontScale': 2.0, 'densityDpi': 320, 'resourceProbes': 3},
                'productionNodeActivated': False, 'ordinaryBetaChanged': False}
            reset_disposable_baseline()
        elif private_management_mode:
            phases = [
                ('privateCreationRestoresSelectedMembersAndCheckpointsARealUnconfirmedRevocation', 'private-revoke-pending'),
                ('coldPrivateRevocationRecoversTheSameOriginalThenCheckpointsARealGrant', 'private-grant-pending'),
                ('coldPrivateGrantRestoresActualEncryptedReadingAndKeepsTheGeneralDraft', None),
                ('compactPrivateRosterKeepsTheActualLocalErrorAndRemovalControlsReachable', None),
            ]
            goals = {'version': 2, 'mode': 'private-management-v1', 'phases': phases,
                'executionScope': 'restricted-creation-and-grant-revoke-process-recovery',
                'remaining139NativeCoverage': ['key-unavailable-administration', 'genuine-rejection-visible-and-recovered'],
                'phaseSeconds': 180, 'checkpointObservationSeconds': .25, 'pixelTolerance': 1,
                'actionSeconds': 5, 'contentSeconds': 15, 'minimumControlDp': 48,
