            recovery = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/compact-reading-recovery.json').stdout)
            (evidence / 'native-compact-reading-recovery.json').write_text(json.dumps(recovery, indent=2))
            if any(recovery[key] != value for key, value in {'pid': pids[3], 'owner': fixtures['owner'],
                    'space': fixtures['space'], 'channel': channel}.items()) or not (
                    0 < recovery['startedAtMs'] <= recovery['completedAtMs'] <= recovery['startedAtMs'] + 15_000):
                raise RuntimeError('Compact latest-message return exceeded the original15second goal')
        elif management_mode:
            if len(set(pids)) != 4: raise RuntimeError('Management phases require four distinct PIDs')
            fixtures = command(control_port, 'management-fixtures')
            final = command(control_port, 'management-status')
            (evidence / 'host-management-final.json').write_text(json.dumps(final, indent=2))
            expected_members = {fixtures['owner']: 'OWNER', fixtures['member']: 'MEMBER'}
            creation = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/creation-recovery.json').stdout)
            creation_host = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/creation-recovery-host.json').stdout)
            (evidence / 'native-creation-recovery.json').write_text(json.dumps(creation, indent=2))
            (evidence / 'native-creation-recovery-host.json').write_text(json.dumps(creation_host, indent=2))
            if creation['channel'] in {fixtures[name] for name in ('general', 'workshop', 'announcements')}:
                raise RuntimeError('Creation reused an existing channel identity')
            expected_channels = {fixtures[name] for name in ('general', 'workshop', 'announcements')} | {creation['channel']}
            if final['members'] != expected_members or set(final['channels']) != expected_channels:
                raise RuntimeError('Final independent management membership/channel scope differs')
            if any(value['archived'] for value in final['channels'].values()):
                raise RuntimeError('The actual managed channels were not reopened')
            checkpoints = [json.loads((evidence / f'checkpoint-{phase}.raw').read_bytes()) for phase in ('role-pending', 'archive-pending')]
            editor = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/editor-recovery.json').stdout)
            editor_host = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/editor-recovery-host.json').stdout)
            (evidence / 'native-editor-recovery.json').write_text(json.dumps(editor, indent=2))
            (evidence / 'native-editor-recovery-host.json').write_text(json.dumps(editor_host, indent=2))
            editor_context = {key: value for key, value in editor.items() if key not in ('recoveryStartedAtMs', 'recoveryCompletedAtMs')}
            if editor_context != {'pid': pids[2], 'owner': fixtures['owner'], 'space': fixtures['space'], 'channel': fixtures['general'],
                          'original': final['dropped'][2], 'name': 'commons', 'category': 'Projects', 'peerDeadlineSeconds': 12, 'freshReadSeconds': 15, 'combinedRecoverySeconds': 27}:
                raise RuntimeError('Editor recovery context or declared boundaries differ')
            if not (0 < editor['recoveryStartedAtMs'] <= editor['recoveryCompletedAtMs'] <= editor['recoveryStartedAtMs'] + 27_000):
                raise RuntimeError('Actual editor recovery exceeded its total27-second budget')
            if editor_host['channels'][fixtures['general']] != {'name': 'commons', 'category': 'Projects', 'archived': False}:
                raise RuntimeError('Independent reader did not receive the actual editor metadata')
            creation_context = {key: value for key, value in creation.items() if key not in ('recoveryStartedAtMs', 'recoveryCompletedAtMs')}
            if creation_context != {'pid': pids[2], 'owner': fixtures['owner'], 'space': fixtures['space'], 'channel': creation['channel'],
                    'original': final['dropped'][3], 'name': 'native-reading-room', 'category': 'Knowledge', 'kind': 'article'}:
                raise RuntimeError('Creation recovery context differs')
            if not (0 < creation['recoveryStartedAtMs'] <= creation['recoveryCompletedAtMs'] <= creation['recoveryStartedAtMs'] + 27_000):
                raise RuntimeError('Actual creation recovery exceeded its total27-second budget')
            if creation_host['channels'][creation['channel']] != {'name': 'native-reading-room', 'category': 'Knowledge', 'archived': False}:
                raise RuntimeError('Independent reader did not receive the created channel metadata')
            if creation_host['space'] != final['space'] or creation_host['members'] != final['members'] or creation_host['channels'] != final['channels']:
                raise RuntimeError('Independent creation and final channel scope differ')
            if creation_host['originals'] != final['originals'][:len(creation_host['originals'])]:
                raise RuntimeError('Creation observation is not the actual received prefix')
            if final['dropped'] != [item['original'] for item in checkpoints] + [editor['original'], creation['original']]:
                raise RuntimeError('Actual dropped reply identities differ from checkpoints/editor')
            if editor_host['originals'] != final['originals'][:len(editor_host['originals'])]:
                raise RuntimeError('Editor observation is not the actual received prefix')
            for checkpoint, kind in zip(checkpoints + [editor, creation], ('set-role', 'archive-channel', 'edit-channel', 'create-channel')):
                rows = [row for row in final['originals'] if row['id'] == checkpoint['original']]
                if len(rows) != 2 or len({row['sha256'] for row in rows}) != 1 or any(
                        row['kind'] != kind or row['actor'] != fixtures['owner'] or row['space'] != fixtures['space'] for row in rows):
                    raise RuntimeError('Recovery did not deliver the exact accepted original twice')
            creation_rows = [row for row in final['originals'] if row['id'] == creation['original']]
            if any(row['channel'] != creation['channel'] or row['profile'] != {'version': 1, 'name': 'native-reading-room', 'kind': 'article', 'category': 'Knowledge'} for row in creation_rows):
                raise RuntimeError('Recovered creation original profile or channel differs')
            for name in ('general', 'workshop', 'announcements'):
                if final['channels'][fixtures[name]] != {'name': name, 'category': '', 'archived': False}:
                    raise RuntimeError('A managed channel profile or archive was not restored')
            for name in ('normal-host', 'compact-host'):
                observed = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/{name}.json').stdout)
                (evidence / f'native-{name}.json').write_text(json.dumps(observed, indent=2))
                if observed['space'] != final['space'] or observed['members'] != final['members'] or observed['channels'] != final['channels']:
                    raise RuntimeError('Native and independent final management state differ')
                if name == 'compact-host' and observed != final:
                    raise RuntimeError('Native compact and final host observations differ')
                if name == 'normal-host' and observed['originals'] != final['originals'][:len(observed['originals'])]:
                    raise RuntimeError('Native normal observation is not the actual received prefix')
            for name, pid in (('role', pids[0]), ('archive', pids[2]), ('compact-role', pids[3]), ('compact-editor', pids[3]), ('compact-creation', pids[3])):
                cleanup = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/cleanup-{name}.json').stdout)
                (evidence / f'local-fault-cleanup-{name}.json').write_text(json.dumps(cleanup, indent=2))
                if cleanup != {'removed': True, 'pid': pid, 'space': fixtures['space'], 'owner': fixtures['owner']}:
                    raise RuntimeError('An owned local write fault was not independently removed')
        else:
            fixtures = command(control_port, 'fixtures')
            cold_public = command(control_port, 'cached-public-observation')
            (evidence / 'host-cold-public-cache.json').write_text(json.dumps(cold_public, indent=2))
            observed_cold = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/cold-public-cache.json').stdout)
            if observed_cold != cold_public or cold_public.get('pid') != pids[1] or cold_public.get('publicReadBarrierArmed') is not True:
                raise RuntimeError('Native and host did not confirm cached public reading before releasing the barrier')
            if cold_public.get('space') != fixtures['public']['space'] or cold_public.get('owner') != json.loads((evidence / 'checkpoint-visitor.raw').read_bytes())['owner']:
                raise RuntimeError('Cached public reading belongs to another identity or community')
            child = command(control_port, 'channel-received', {'space': fixtures['private']['space'], 'channel': 'design'})
            (evidence / 'host-private-child-received.json').write_text(json.dumps(child, indent=2))
            sender = json.loads((evidence / 'checkpoint-member.raw').read_bytes())['owner']
            matched = [row for row in child['received'] if row['author'] == sender and row['text'] == 'Private child survives invitation revocation']
            if len(matched) != 1:
                raise RuntimeError('Independent host did not decrypt exactly one intended child original')
            observed_child = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/private-child-received.json').stdout)
            if observed_child != matched[0]:
                raise RuntimeError('Native and independent host observed different child originals')
            peer_recovery = command(control_port, 'read-recovery')
            (evidence / 'host-peer-read-recovery.json').write_text(json.dumps(peer_recovery, indent=2))
            observed_recovery = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/peer-read-recovery.json').stdout)
            if observed_recovery.pop('pid') != pids[2] or observed_recovery != peer_recovery or peer_recovery.get('author') != sender:
                raise RuntimeError('Native and independent host did not confirm the same peer-read recovery')
        if management_mode and not private_readiness_mode and not membership_mode:
            focused_raw = adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/focused-field-geometry.jsonl').stdout
            (evidence / 'native-focused-field-geometry.jsonl').write_bytes(focused_raw)
            focused = [json.loads(line) for line in focused_raw.splitlines() if line]
            expected_fields = [('Category name', 'Compact private conversations')] * 2 if governance_mode else [('Category name', 'Compact community conversations')] * 2 if category_management_mode else [('Channel name', 'native-private-reading'), ('Category (optional)', 'Shared plans')] if private_management_mode else [
                ('Channel name', 'compact-commons'), ('Category (optional)', 'Projects'),
                ('Channel name', 'compact-commons'), ('Category (optional)', 'Projects'),
                ('Channel name', 'compact-new-room'), ('Channel name', 'compact-editable-after-error')]
            if [(row['label'], row['value']) for row in focused] != expected_fields:
                raise RuntimeError('Focused editing cases are missing or reordered')
            for row in focused:
                bounds, window = row['bounds'], row['root']
                if row['pid'] != pids[2 if governance_mode else 1 if category_management_mode else 2 if private_management_mode else 3] or row['focused'] is not True or row['fontScale'] <= 0 or (
                        not private_management_mode and row['fontScale'] != 2.0) or min(row['width'], row['height']) <= 0 or (
                        row['width'] > row['clippedWidth'] + 1 or row['height'] > row['clippedHeight'] + 1) or any(
                        not isinstance(value, (int, float)) for value in bounds + window) or (
                        bounds[0] < window[0] - 1 or bounds[1] < window[1] - 1 or bounds[2] > window[2] + 1 or bounds[3] > window[3] + 1):
                    raise RuntimeError('The actual focused field is clipped or belongs to another native phase')
                physical = row['physicalBounds']
                if len(physical) != 4 or any(type(value) is not int for value in physical) or not (0 < row['imeBottom'] < row['displayHeight']) or row['displayWidth'] <= 0 or (
                        physical[0] < 0 or physical[1] < 0 or physical[2] > row['displayWidth'] or physical[3] > row['displayHeight'] - row['imeBottom']) or (
                        physical[2] - physical[0] < row['width'] - 1 or physical[3] - physical[1] < row['height'] - 1):
                    raise RuntimeError('Focused field was not independently visible above the actual focused-window IME')
        (evidence / 'host-status.json').write_text(json.dumps(command(control_port, 'status')))
        command(control_port, 'stop'); host.wait(timeout=15)
        if host.returncode:
            raise RuntimeError(f'Owned {label} host failed its actual effects/cleanup')
        (evidence / 'journey-outcome.json').write_text(json.dumps({'source': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo).decode().strip(),
            'phasePids': pids, 'nativeTerminalPasses': 2, 'deliberatelyInterruptedCases': 0 if private_readiness_mode or category_management_mode else 2,
            'productionNodeActivated': False, 'ordinaryBetaChanged': False}))
    elif visual_mode:
        reset_disposable_baseline()
        sdk = 17 if os.environ['TEST_DEVICE_API'].startswith('37') else 10
