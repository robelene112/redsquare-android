        session = instrument('protectedChatSurvivesForceStopAndReconcilesTheSameNativeOriginal',
                             'protected-chat-after-kill.txt', peer_port, control_port)
        session.wait(timeout=120)
        output = (evidence / 'protected-chat-after-kill.txt').read_text()
        if session.returncode or len(re.findall(r'^OK \(1 test\)\s*$', output, re.M)) != 1:
            raise RuntimeError('Native protected Chat verification failed')
        proof = json.loads(adb('exec-out', 'run-as', pkg, 'cat',
            f'cache/{folder}/protected-chat-result.json').stdout)
        if (not proof['readByIndependentPeer'] or not proof['exactOriginal'] or not proof['screenTapReceived'] or
                proof['encryptedOriginals'] != proof['contentOriginals'] or proof['originalSubmissions'] < 2 or
                proof['recoveredPid'] == pending['pid'] or proof['original'] != pending['original']):
            raise RuntimeError('Independent encrypted round trip did not satisfy the expected effects')
        (evidence / 'protected-chat-result.json').write_text(json.dumps(proof, indent=2))
        finish_record(*movies[-1])
        (evidence / 'journey-outcome.json').write_text(json.dumps({
            'source': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo).decode().strip(),
            'oldPid': pending['pid'], 'newPid': proof['recoveredPid'], 'nativeTerminalPasses': 1,
            'deliberatelyInterruptedCases': 1, 'exactOriginal': proof['exactOriginal'],
            'encryptedOriginals': proof['encryptedOriginals'], 'originalSubmissions': proof['originalSubmissions'],
            'readByIndependentPeer': proof['readByIndependentPeer'], 'screenTapReceived': proof['screenTapReceived'],
            'productionNodeActivated': False}, indent=2))
    elif conversation_overlays_mode:
        record(1)
        session = instrument('messageMenusAndEditSurviveIncomingMessagesAndRealIme', 'conversation-overlays.txt', peer_port, control_port)
        session.wait(timeout=180)
        output = (evidence / 'conversation-overlays.txt').read_text()
        if session.returncode or len(re.findall(r'^OK \(1 test\)\s*$', output, re.M)) != 1:
            raise RuntimeError('Focused conversation overlays failed; retain the original native result')
        observed = json.loads(adb('exec-out', 'run-as', pkg, 'cat', 'cache/spaces-journey-evidence/overlay-results.json').stdout)
        if not (observed['pid'] > 0 and observed['imeBottom'] > 0 and observed['activityRecreated'] and
                observed['editedMessage']['edited'] and observed['incomingDuringIme']['count'] >= 8 and
                observed['androidConsumptionWhileImeOpen']['observed'] and observed['androidConsumptionWhileImeOpen']['request'] and
                observed['readingConsumption']['observed'] and observed['readingConsumption']['request'] and
                observed['readingConsumption']['message'] == observed['readingIncoming']['id'] and observed['deletedMessage']['deleted']):
            raise RuntimeError('Focused conversation observations are incomplete')
        (evidence / 'overlay-results.json').write_text(json.dumps(observed, indent=2))
        finish_record(*movies[-1]); record(2)
        pins_session = instrument('pinsOpenTheirExactRootAndThreadWhilePreservingWriting', 'conversation-pins.txt', peer_port, control_port)
        pins_session.wait(timeout=180)
        pins_output = (evidence / 'conversation-pins.txt').read_text()
        if pins_session.returncode or len(re.findall(r'^OK \(1 test\)\s*$', pins_output, re.M)) != 1:
            raise RuntimeError('Focused conversation pins failed; retain the original native result')
        pins = json.loads(adb('exec-out', 'run-as', pkg, 'cat', 'cache/spaces-journey-evidence/pins-results.json').stdout)
        if not (pins['pid'] > 0 and pins['root']['pinned'] and pins['reply']['pinned'] and
                pins['reply']['parent'] == pins['root']['id'] and pins['channelDraftPreserved'] and pins['threadDraftPreserved'] and pins['pinSheetRestoredAfterRecreate'] and
                pins['incomingWhileOpen'] >= 60 and pins['androidConsumptionWhilePinsOpen']['observed'] and pins['androidConsumptionWhilePinsOpen']['request']):
            raise RuntimeError('Focused native pin observations are incomplete')
        (evidence / 'pins-results.json').write_text(json.dumps(pins, indent=2))
        finish_record(*movies[-1]); record(3)
        attention_session = instrument('unreadBadgeDistinguishesOrdinaryMessagesFromPersonalMentions',
                                      'conversation-attention.txt', peer_port, control_port)
        attention_session.wait(timeout=180)
        attention_output = (evidence / 'conversation-attention.txt').read_text()
        if attention_session.returncode or len(re.findall(r'^OK \(1 test\)\s*$', attention_output, re.M)) != 1:
            raise RuntimeError('Focused unread badge check failed')
        attention = json.loads(adb('exec-out', 'run-as', pkg, 'cat', 'cache/spaces-journey-evidence/attention-results.json').stdout)
        if not (attention['ordinaryDot'] and attention['personalCount'] == 1 and attention['acknowledgedAfterReading'] and
                attention['silentRestored'] and attention['mention']['position'] > attention['ordinary']['position']):
            raise RuntimeError('Focused unread badge observations are incomplete')
        (evidence / 'attention-results.json').write_text(json.dumps(attention, indent=2))
        (evidence / 'host-status.json').write_text(json.dumps(command(control_port, 'status')))
        command(control_port, 'stop'); host.wait(timeout=15)
        if host.returncode: raise RuntimeError('Owned conversation host failed')
        (evidence / 'journey-outcome.json').write_text(json.dumps({'source': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo).decode().strip(),
            'pid': observed['pid'], 'pinsPid': pins['pid'], 'nativeTerminalPasses': 3, 'deliberatelyInterruptedCases': 0,
            'distinctPidAcceptance': False, 'whole140Acceptance': False, 'productionNodeActivated': False}))
    else:
        record(1)
        first = instrument('createInviteJoinReadAndCheckpointAnUncertainOriginal', 'before-kill.txt', peer_port, control_port)
        deadline = time.monotonic() + 180
        while True:
            observed = adb('exec-out', 'run-as', pkg, 'cat', 'cache/spaces-journey-checkpoint.json', check=False)
            if time.monotonic() >= deadline:
                raise RuntimeError('Native create/join/checkpoint exceeded its 180-second bound')
            candidate = observed.returncode == 0 and observed.stdout.lstrip().startswith(b'{')
            with (evidence / 'checkpoint-observations.jsonl').open('a') as observations:
                observations.write(json.dumps({'remainingSeconds': round(deadline - time.monotonic(), 3),
                    'exit': observed.returncode, 'bytes': len(observed.stdout), 'candidateJson': candidate,
                    'nonJsonOutput': None if candidate else observed.stdout[:360].decode('utf-8', errors='replace')}) + '\n')
            if candidate:
                # Atomic device publication makes a malformed visible checkpoint
                # an actual failure; retain its original bytes before parsing.
                (evidence / 'observed-checkpoint.raw').write_bytes(observed.stdout)
                checkpoint = json.loads(observed.stdout)
                if checkpoint['phase'] == 'ready-for-process-kill':
                    break
            if first.poll() is not None:
                raise RuntimeError('Native test ended before its checkpoint; inspect before-kill.txt')
            time.sleep(.25)
        (evidence / 'checkpoint.json').write_text(json.dumps(checkpoint))
        pid = adb('shell', 'pidof', pkg).stdout.decode().strip()
        if pid != str(checkpoint['pid']):
            raise RuntimeError('Checkpoint does not belong to the live Android process')
        adb('shell', 'am', 'force-stop', pkg)
        first.wait(timeout=15)
        if adb('shell', 'pidof', pkg, check=False).stdout.strip():
            raise RuntimeError('Original Android PID still exists')
        (evidence / 'process-kill.json').write_text(json.dumps({'oldPid': checkpoint['pid'], 'forceStopped': True,
            'firstInstrumentExit': first.returncode, 'expectedInterruptedTest': True}))
        # End the first recording using the actual device screenrecord process.
        finish_record(*movies[-1])
        record(2)
        second = instrument('coldReturnReconcilesTheSameOriginalAndKeepsNewWriting', 'after-kill.txt', peer_port, control_port)
        second.wait(timeout=90)
        if second.returncode != 0 or 'OK (1 test)' not in (evidence / 'after-kill.txt').read_text():
            raise RuntimeError('Native distinct-process recovery failed')
        (evidence / 'host-status.json').write_text(json.dumps(command(control_port, 'status')))
        command(control_port, 'stop'); host.wait(timeout=15)
        if host.returncode != 0:
            raise RuntimeError('Owned host could not verify/close actual received effects')
        recovered = json.loads(adb('exec-out', 'run-as', pkg, 'cat', 'cache/spaces-journey-evidence/recovered.json').stdout)
        if recovered['recoveredPid'] == checkpoint['pid']:
            raise RuntimeError('Recovery reused the old Android PID')
        (evidence / 'journey-outcome.json').write_text(json.dumps({'source': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo).decode().strip(),
            'oldPid': checkpoint['pid'], 'newPid': recovered['recoveredPid'], 'nativeTerminalPasses': 1,
            'deliberatelyInterruptedCases': 1, 'productionNodeActivated': False}))

finally:
    # Each bounded cleanup is independent, and its exception must not replace
    # the original native/checkpoint failure or prevent remaining teardown.
    primary = sys.exc_info()[1]
    cleanup_errors = []
    def cleanup(label, action):
        try:
            return action()
        except Exception as failure:
            cleanup_errors.append({'stage': label, 'error': type(failure).__name__})
            return None
    def capture_crash():
        (evidence / 'crash.log').write_bytes(adb('logcat', '-d', '-b', 'crash', timeout=10).stdout)
        (evidence / 'last-window.png').write_bytes(adb('exec-out', 'screencap', '-p', timeout=10).stdout)
    if owned_emulator:
        cleanup('failure-buffers', capture_crash)
        cleanup('fixture-account-diagnostics', lambda: (evidence / 'spaces-account.log').write_bytes(
            adb('logcat', '-d', '-v', 'threadtime', '-s', 'SpacesAccount138:D', 'SpaceFileProofViewer:E', 'SaitoTalk:D', '*:S', timeout=10).stdout))
        if room_mode:
            cleanup('room-codec-diagnostics', lambda: (evidence / 'room-codecs.log').write_bytes(
                adb('logcat', '-d', '-v', 'threadtime', '-t', '10000', '-s', 'libjingle:V', 'org.webrtc.Logging:V',
                    'MediaCodec:V', 'CCodec:V', 'Codec2Client:V', 'ACodec:V', 'HardwareVideoDecoder:V', '*:S', timeout=10).stdout))
    if primary is not None and control_port and host.poll() is None:
        def observe_host_failure():
            (evidence / 'failure-host-status.json').write_text(json.dumps(command(control_port, 'status'), indent=2))
        cleanup('independent-failure-observation', observe_host_failure)
        if governance_mode or membership_mode:
            selected_status = 'membership-status' if membership_mode else 'governance-status'
            cleanup('selected-mode-failure-observation', lambda: (evidence / ('failure-host-' + selected_status + '.json')).write_text(
                json.dumps(command(control_port, selected_status), indent=2)))
    if owned_emulator:
        cleanup('stop-owned-android-process', lambda: adb('shell', 'am', 'force-stop', pkg))
        if file_mode:
            cleanup('stop-owned-file-viewer', lambda: adb('shell', 'am', 'force-stop', pkg + '.test'))
    if article_agreement_owned:
        cleanup('remove-owned-article-agreement-fixture',
                lambda: adb('shell', 'run-as', pkg, 'rm', '-f', 'no_backup/publishing-policy-fixture.json'))
    for process, remote, phase in movies:
        def stop_movie(process=process, remote=remote, phase=phase):
            try:
                if not movie_owners.get(phase, {}).get('stopped'): finish_record(process, remote, phase)
            except Exception:
                if process.poll() is None:
                    process.kill(); process.wait(timeout=5)
                raise
        cleanup(f'stop-movie-{phase}', stop_movie)
        cleanup(f'pull-movie-{phase}', lambda remote=remote, phase=phase:
            adb('pull', remote, str(evidence / f'phase-{phase}.mp4'), timeout=30))
    def archive():
        capture = adb('exec-out', 'run-as', pkg, 'tar', '-C', 'cache', '-cf', '-',
                      folder, timeout=30, check=False)
        (evidence / 'native-evidence.tar').write_bytes(capture.stdout)
        (evidence / 'native-evidence-capture.json').write_text(json.dumps({'exit': capture.returncode}))
        if capture.returncode: raise RuntimeError('Native evidence archive failed')
    if owned_emulator:
        cleanup('native-archive', archive)
    # Resizing a running recorder crops its projection. Restore only after all
    # recordings and native originals have been stopped, pulled and retained.
    if visual_settings is not None:
        cleanup('restore-visual-viewports', visual_settings.restore)
    if room_rotation_original is not None:
        def restore_rotation():
            for key, value in room_rotation_original.items():
                if value == 'null': adb('shell', 'settings', 'delete', 'system', key)
                else: adb('shell', 'settings', 'put', 'system', key, value)
            restored = {key: adb('shell', 'settings', 'get', 'system', key).stdout.decode().strip()
                for key in room_rotation_original}
            (evidence / 'rotation-restored.json').write_text(json.dumps(restored, indent=2))
            if restored != room_rotation_original: raise RuntimeError('Owned emulator rotation was not restored')
        cleanup('restore-room-rotation', restore_rotation)
    if viewport_original is not None:
        cleanup('restore-viewport-size', lambda: adb('shell', 'wm', 'size', viewport_original['size']['override'] or 'reset'))
        cleanup('restore-viewport-density', lambda: adb('shell', 'wm', 'density', viewport_original['density']['override'] or 'reset'))
        def restore_font():
            font = viewport_original['fontSetting']
            adb('shell', 'settings', 'delete', 'system', 'font_scale') if font == 'null' else adb('shell', 'settings', 'put', 'system', 'font_scale', font)
        cleanup('restore-viewport-font', restore_font)
        cleanup('verify-restored-viewport', verify_restored_viewport)
        cleanup('stop-viewport-probe', lambda: adb('shell', 'am', 'force-stop', pkg))
    if control_port and host.poll() is None:
        cleanup('stop-owned-host', lambda: command(control_port, 'stop'))
    for process, log in reversed(children):
        def stop_child(process=process, log=log):
            try:
                if process.poll() is None:
                    process.terminate()
                    try: process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        process.kill(); process.wait(timeout=5)
            finally: log.close()
        cleanup('owned-child', stop_child)
    if control_port:
        for port in reverses:
            cleanup(f'reverse-{port}', lambda port=port: adb('reverse', '--remove', f'tcp:{port}'))
    if 'hostroot' in globals():
        for name in ('ready.json', 'result.json', 'host.log', *(path.name for path in hostroot.glob('file-provider-*.log'))):
            def copy_host(name=name):
                path = hostroot / name
                if path.exists(): (evidence / ('host-' + name)).write_bytes(path.read_bytes())
            cleanup('host-observation-' + name, copy_host)
    (evidence / 'cleanup.json').write_text(json.dumps({'originalFailure': type(primary).__name__ if primary else None,
                                                     'errors': cleanup_errors}, indent=2))
    if primary is None and not cleanup_errors:
        (evidence / 'acceptance.json').write_bytes((evidence / 'journey-outcome.json').read_bytes())
    files = []
    for path in sorted(evidence.rglob('*')):
        if path.is_file():
            with path.open('rb') as content:
                hasher = hashlib.sha256()
                for chunk in iter(lambda: content.read(1024 * 1024), b''):
                    hasher.update(chunk)
                digest = hasher.hexdigest()
            files.append({'path': str(path.relative_to(evidence)), 'bytes': path.stat().st_size, 'sha256': digest})
    (evidence / 'files.json').write_text(json.dumps(files, indent=2))
    if primary is None and cleanup_errors:
        raise RuntimeError('Native journey cleanup failed; inspect cleanup.json')
