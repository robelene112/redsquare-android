#!/usr/bin/env python3
"""Owned emulator only: real host peer plus distinct Android PID recovery."""
import hashlib
import json
import os
import re
import struct
from pathlib import Path
import subprocess
import sys
import time
import urllib.request

repo = Path(__file__).resolve().parent.parent
mode = sys.argv[2] if len(sys.argv) == 3 else 'journey-v1'
if len(sys.argv) not in (2, 3) or mode not in ('journey-v1', 'discovery-v1', 'management-v1') or (len(sys.argv) == 3 and mode == 'journey-v1'):
    raise ValueError('Expected evidence directory and optional discovery-v1 or management-v1')
discovery_mode = mode == 'discovery-v1'
management_mode = mode == 'management-v1'
community_mode = discovery_mode or management_mode
label = 'management' if management_mode else 'discovery' if discovery_mode else 'journey'
folder = f'spaces-{label}-evidence'
checkpoint_name = f'spaces-{label}-checkpoint.json'
classname = 'SpacesManagementJourneyTest' if management_mode else 'SpacesDiscoveryJourneyTest' if discovery_mode else 'SpacesJourneyTest'
evidence = Path(sys.argv[1]).resolve() / f'spaces-{label}'
evidence.mkdir(parents=True, exist_ok=False)
pkg = 'nl.davidengelen.redsquare.dev'
runner = pkg + '.test/androidx.test.runner.AndroidJUnitRunner'
children = []

def adb(*args, timeout=15, check=True):
    return subprocess.run(['adb', *args], capture_output=True, timeout=timeout, check=check)

def command(port, action, payload=None):
    request = urllib.request.Request(f'http://127.0.0.1:{port}/{action}', json.dumps(payload or {}).encode(), {'Content-Type': 'application/json'})
    with urllib.request.urlopen(request, timeout=5) as response:
        return json.load(response)

def instrument(method, filename, peer, control):
    log = (evidence / filename).open('wb')
    process = subprocess.Popen(['adb', 'shell', 'am', 'instrument', '-w', '-r',
        '-e', 'class', f'nl.davidengelen.redsquare.{classname}#{method}',
        '-e', 'spacesPeerPort', str(peer), '-e', 'spacesControlPort', str(control)] +
        (['-e', 'spacesDisposableBaseline', 'true'] if management_mode else []) + [runner],
        stdout=log, stderr=subprocess.STDOUT)
    children.append((process, log))
    return process

control_port = None
movies = []
movie_owners = {}
viewport_original = None

def viewport_observation(stage, expected=None):
    args = ['shell', 'am', 'instrument', '-w', '-r', '-e', 'class',
        'nl.davidengelen.redsquare.SpacesViewportConfigurationTest#observeOwnedConfiguration',
        '-e', 'spacesViewportStage', stage]
    for name, value in (expected or {}).items():
        args += ['-e', name, str(value)]
    if management_mode:
        args += ['-e', 'spacesViewportFolder', folder]
    observed = adb(*args, runner, timeout=30, check=False)
    text = observed.stdout.decode(errors='replace')
    (evidence / f'viewport-{stage}-probe.txt').write_bytes(observed.stdout + observed.stderr)
    if observed.returncode or len(re.findall(r'^OK \(1 test\)\s*$', text, re.M)) != 1:
        raise RuntimeError(f'Actual viewport {stage} resource probe failed')
    value = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/viewport-{stage}.json').stdout)
    (evidence / f'viewport-{stage}-resources.json').write_text(json.dumps(value, indent=2))
    return value

def viewport_override(kind):
    text = adb('shell', 'wm', kind).stdout.decode().strip()
    pattern = r'[0-9]+x[0-9]+' if kind == 'size' else r'[0-9]+'
    physical = re.findall(r'Physical ' + kind + ': (' + pattern + ')', text)
    override = re.findall(r'Override ' + kind + ': (' + pattern + ')', text)
    if len(physical) != 1 or len(override) > 1:
        raise RuntimeError('Unrecognized actual viewport setting')
    return {'physical': physical[0], 'override': override[0] if override else None}

def prepare_viewport():
    global viewport_original
    # Capture every original before the first mutation. Separate resource probes
    # observe the actual Android configuration, not a shell command's intent.
    viewport_original = {'size': viewport_override('size'), 'density': viewport_override('density'),
        'fontSetting': adb('shell', 'settings', 'get', 'system', 'font_scale').stdout.decode().strip()}
    if not re.fullmatch(r'null|[0-9]+(?:\.[0-9]+)?', viewport_original['fontSetting']):
        raise RuntimeError('Unrecognized original font setting')
    (evidence / 'viewport-original.json').write_text(json.dumps(viewport_original, indent=2))
    viewport_original['resources'] = viewport_observation('baseline')
    (evidence / 'viewport-original.json').write_text(json.dumps(viewport_original, indent=2))
    adb('shell', 'am', 'force-stop', pkg)
    adb('shell', 'wm', 'size', '640x1280')
    adb('shell', 'wm', 'density', '320')
    adb('shell', 'settings', 'put', 'system', 'font_scale', '2.0')
    viewport_observation('prepared', {'spacesExpectedFont': 2.0, 'spacesExpectedWidth': 320, 'spacesExpectedDensity': 320})
    if viewport_override('size')['override'] != '640x1280' or viewport_override('density')['override'] != '320':
        raise RuntimeError('Owned compact viewport did not apply')
    deadline = time.monotonic() + 10
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0: raise RuntimeError('Compact compositor dimensions did not settle within10s')
        png = adb('exec-out', 'screencap', '-p', timeout=min(5, remaining)).stdout
        (evidence / 'viewport-prepared.png').write_bytes(png)
        if png.startswith(b'\x89PNG\r\n\x1a\n') and struct.unpack('>II', png[16:24]) == (640, 1280): break
        time.sleep(.05)

def verify_restored_viewport():
    original = viewport_original
    resources = original['resources']
    observed = viewport_observation('restored', {'spacesExpectedFont': resources['fontScale'],
        'spacesExpectedWidth': resources['screenWidthDp'], 'spacesExpectedDensity': resources['densityDpi']})
    size, density = viewport_override('size'), viewport_override('density')
    implicit = (resources['sdk'] == 29 and original['fontSetting'] == 'null' and resources['fontScale'] == 1.0 and observed['fontSetting'] == '1.0')
    result = {'size': size, 'density': density, 'fontSetting': observed['fontSetting'], 'implicitAndroid10Default': implicit}
    (evidence / 'viewport-restoration.json').write_text(json.dumps(result, indent=2))
    if size != original['size'] or density != original['density'] or not (observed['fontSetting'] == original['fontSetting'] or implicit):
        raise RuntimeError('Original viewport configuration was not restored')

try:
    serial = adb('get-serialno').stdout.decode().strip()
    if not serial.startswith('emulator-'):
        raise RuntimeError('Only a disposable emulator may run this fixture')
    classpath = (repo / 'spaces-service/build/host-fixture-classpath.txt').read_text().strip()
    native = repo / 'core/build/generated/spaces-mls-host'
    hostroot = repo / '.scratch' / ((f'spaces-{label}-host-' if community_mode else 'spaces-native-host-') + os.environ['TEST_DEVICE_API'])
    hostroot.mkdir(parents=True, exist_ok=False)
    hostlog = (hostroot / 'host.log').open('wb')
    host = subprocess.Popen(['java', '-Xmx512m', f'-Djava.library.path={native}', '-cp', classpath,
        'nl.davidengelen.redsquare.spaces.service.SpacesNativeHost', str(hostroot)] + ([mode] if community_mode else []), stdout=hostlog, stderr=subprocess.STDOUT)
    children.append((host, hostlog))
    deadline = time.monotonic() + 30
    while not (hostroot / 'ready.json').exists():
        if host.poll() is not None:
            raise RuntimeError('Owned Spaces host stopped before readiness; inspect host-host.log')
        if time.monotonic() >= deadline:
            raise RuntimeError('Owned Spaces host did not become ready within 30 seconds')
        time.sleep(.1)
    ready = json.loads((hostroot / 'ready.json').read_text())
    peer_port, control_port = ready['peerPort'], ready['controlPort']
    for port in (peer_port, control_port):
        adb('reverse', f'tcp:{port}', f'tcp:{port}')
    # One unbroken movie per phase. Native goals stay bounded independently.
    def record(phase):
        remote = f'/sdcard/spaces-{label}-{phase}.mp4'
        logfile = (evidence / f'movie-{phase}.log').open('wb')
        process = subprocess.Popen(['adb', 'shell', '-n', 'screenrecord', '--time-limit', '180',
            '--bit-rate', '2000000', remote], stdin=subprocess.DEVNULL, stdout=logfile, stderr=subprocess.STDOUT)
        children.append((process, logfile)); movies.append((process, remote, phase))
        deadline = time.monotonic() + 5
        def provision_probe(*args):
            remaining = deadline - time.monotonic()
            if remaining <= 0: raise RuntimeError('Owned recorder did not start within5s')
            return adb(*args, timeout=min(2, remaining), check=False)
        while True:
            observed = provision_probe('shell', 'pidof', 'screenrecord')
            matches = []
            for raw in observed.stdout.split():
                if not raw.isdigit(): raise RuntimeError('Recorder PID observation was not numeric')
                pid = int(raw)
                commandline = provision_probe('shell', 'cat', f'/proc/{pid}/cmdline')
                args = commandline.stdout.split(b'\0')
                if commandline.returncode == 0 and remote.encode() in args and args[0].endswith(b'screenrecord'):
                    matches.append(pid)
            if len(matches) > 1: raise RuntimeError('More than one owned recorder has this phase path')
            if matches:
                if process.poll() is not None or time.monotonic() >= deadline:
                    raise RuntimeError('Owned recorder ended or exceeded5s before readiness')
                movie_owners[phase] = {'pid': matches[0], 'remote': remote, 'started': True}
                (evidence / f'recorder-{phase}.json').write_text(json.dumps(movie_owners[phase]))
                return process
            if process.poll() is not None or time.monotonic() >= deadline:
                raise RuntimeError('Owned recorder did not start within5s')
            time.sleep(.05)

    def finish_record(process, remote, phase):
        deadline = time.monotonic() + 15
        owner = movie_owners.get(phase)
        if owner is None: raise RuntimeError('Recorder has no verified owned PID')
        def probe(*args):
            remaining = deadline - time.monotonic()
            if remaining <= 0: raise subprocess.TimeoutExpired(process.args, 15)
            return adb(*args, timeout=min(5, remaining), check=False)
        def device_state():
            observed = probe('shell', 'cat', f'/proc/{owner["pid"]}/cmdline')
            if observed.returncode == 0:
                args = observed.stdout.split(b'\0')
                return 'owned' if remote.encode() in args and args[0].endswith(b'screenrecord') else 'reused'
            exists = probe('shell', 'test', '-d', f'/proc/{owner["pid"]}')
            if exists.returncode == 1 and not exists.stdout and not exists.stderr: return 'gone'
            raise RuntimeError('Could not verify the owned device recorder identity')
        before = device_state()
        owner['deviceBeforeStop'] = before
        if before == 'owned':
            signal = probe('shell', 'kill', '-2', str(owner['pid']))
            owner['signalExit'] = signal.returncode
            owner['signalStdout'] = signal.stdout.decode(errors='replace')
            owner['signalStderr'] = signal.stderr.decode(errors='replace')
            (evidence / f'recorder-{phase}.json').write_text(json.dumps(owner))
            if signal.returncode != 0 and device_state() == 'owned':
                raise RuntimeError('Owned recorder refused SIGINT')
        after = device_state()
        while after == 'owned':
            if time.monotonic() >= deadline: raise subprocess.TimeoutExpired(process.args, 15)
            time.sleep(.05); after = device_state()
        owner['deviceAfterStop'] = after
        remaining = deadline - time.monotonic()
        if remaining <= 0: raise subprocess.TimeoutExpired(process.args, 15)
        process.wait(timeout=remaining)
        owner['transportExit'] = process.returncode
        (evidence / f'recorder-{phase}.json').write_text(json.dumps(owner))
        if process.returncode != 0 or time.monotonic() >= deadline:
            raise RuntimeError('Recorder transport did not complete successfully within15s')
        owner['stopped'] = True
        (evidence / f'recorder-{phase}.json').write_text(json.dumps(owner))
    if community_mode:
        # Freeze the whole selected journey before the first measurement.
        if management_mode:
            phases = [
                ('ownerSeesLocalRoleErrorsAndCheckpointsAnActuallyAcceptedUnconfirmedPromotion', 'role-pending'),
                ('coldRoleRecoveryKeepsTheOriginalThenCheckpointsAnUnconfirmedChildArchive', 'archive-pending'),
                ('coldArchiveRecoveryAndRealReopeningKeepHistoryAndLocalErrorsReachable', None),
                ('compactLargeTypeShowsActualRoleErrorsAndArchiveControlsWithoutClipping', None),
            ]
            goals = {'version': 1, 'mode': 'management-v1', 'phases': phases,
                'phaseSeconds': 180, 'checkpointObservationSeconds': .25, 'pixelTolerance': 1,
                'actionSeconds': 5, 'contentSeconds': 15, 'minimumControlDp': 48,
                'lostAcceptedReplies': ['set-role', 'archive-channel'], 'exactOriginalAttempts': 2,
                'localWriteFailureCases': ['role', 'archive', 'compact-role'],
                'viewport': {'widthDp': 320, 'fontScale': 2.0, 'densityDpi': 320, 'resourceProbes': 3},
                'productionNodeActivated': False, 'ordinaryBetaChanged': False}
            # This mode owns the freshly provisioned dev-package baseline. Never
            # clear the ordinary signed package or reuse a user's device here.
            reset = adb('shell', 'pm', 'clear', pkg)
            if reset.stdout.strip() != b'Success': raise RuntimeError('Disposable dev baseline was not cleared')
            (evidence / 'disposable-baseline.json').write_text(json.dumps({'package': pkg, 'serial': serial,
                'clearExit': reset.returncode, 'ordinaryPackageTouched': False}))
        else:
            phases = [
                ('publicDiscoveryReadsWithoutJoiningAndCheckpointsTheActualVisitorPixel', 'visitor'),
                ('coldPublicReferenceReviewsRulesAndKeepsPerChannelDraftsAndMemberReturns', 'member'),
                ('coldMemberReturnCreatesAndReviewsInvitationsAndReadsUnlistedLinks', None),
                ('compactLargeTypeKeepsRealCommunityAndCreationControlsReachable', None),
            ]
            goals = {'version': 4, 'phases': phases,
                'phaseSeconds': 180, 'checkpointObservationSeconds': .25, 'pixelTolerance': 1,
                'peerReadRecovery': {'droppedReplies': 1, 'peerDeadlineSeconds': 12, 'freshReadSeconds': 15, 'sameProcess': True},
                'cachedPublicReference': {'publicReadBarrierArmed': True, 'pixelTolerance': 1, 'contentSeconds': 15},
                'viewport': {'widthDp': 320, 'fontScale': 2.0, 'densityDpi': 320, 'resourceProbes': 3},
                'productionNodeActivated': False, 'ordinaryBetaChanged': False}
        (evidence / 'frozen-goals.json').write_text(json.dumps(goals, indent=2))
        pids = []
        for number, (method, expected_phase) in enumerate(phases, 1):
            if number == 4: prepare_viewport()
            record(number)
            native = instrument(method, f'phase-{number}.txt', peer_port, control_port)
            if expected_phase:
                deadline = time.monotonic() + 180
                while True:
                    if time.monotonic() >= deadline:
                        raise RuntimeError(f'Native {label} phase {number} exceeded180s')
                    observed = adb('exec-out', 'run-as', pkg, 'cat', f'cache/{checkpoint_name}', check=False)
                    if observed.returncode == 0 and observed.stdout.lstrip().startswith(b'{'):
                        checkpoint = json.loads(observed.stdout)
                        if checkpoint['phase'] == expected_phase:
                            (evidence / f'checkpoint-{expected_phase}.raw').write_bytes(observed.stdout)
                            break
                    if native.poll() is not None:
                        raise RuntimeError(f'Native {label} phase {number} ended before checkpoint')
                    time.sleep(.25)
                pid = adb('shell', 'pidof', pkg).stdout.decode().strip()
                if pid != str(checkpoint['pid']) or checkpoint['pid'] in pids:
                    raise RuntimeError('Checkpoint process identity mismatch')
                pids.append(checkpoint['pid'])
                if management_mode:
                    snapshot = command(control_port, 'management-status')
                    (evidence / f'host-{expected_phase}.json').write_text(json.dumps(snapshot, indent=2))
                    native_snapshot = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/{expected_phase}-host.json').stdout)
                    if native_snapshot != snapshot or snapshot['dropped'][-1] != checkpoint['original']:
                        raise RuntimeError('Pending native and independent host effects differ')
                    fixtures = checkpoint['fixtures']
                    if snapshot['space'] != fixtures['space'] or checkpoint['owner'] != fixtures['owner']:
                        raise RuntimeError('Pending management context belongs to another actor or Space')
                    role = 'ADMIN' if expected_phase == 'role-pending' else 'MEMBER'
                    if snapshot['members'][fixtures['member']] != role:
                        raise RuntimeError('Independent member did not receive the expected role')
                    if snapshot['channels'][fixtures['workshop']]['archived'] != (expected_phase == 'archive-pending'):
                        raise RuntimeError('Independent channel did not receive the expected archive')
                adb('shell', 'am', 'force-stop', pkg); native.wait(timeout=15)
                if adb('shell', 'pidof', pkg, check=False).stdout.strip():
                    raise RuntimeError('Checkpoint PID remains alive')
                (evidence / f'kill-{expected_phase}.json').write_text(json.dumps({'pid': checkpoint['pid'],
                    'expectedInterruptedCase': True, 'instrumentExit': native.returncode}))
            else:
                native.wait(timeout=180)
                if native.returncode or 'OK (1 test)' not in (evidence / f'phase-{number}.txt').read_text():
                    raise RuntimeError(f'Native {label} final phase failed')
                completed = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/{"compact-completed.json" if number == 4 else "completed.json"}').stdout)
                if number == 3 and completed['pid'] in pids:
                    raise RuntimeError('Final phase reused a checkpoint PID')
                pids.append(completed['pid'])
            finish_record(*movies[-1])
        if management_mode:
            if len(set(pids)) != 4: raise RuntimeError('Management phases require four distinct PIDs')
            fixtures = command(control_port, 'management-fixtures')
            final = command(control_port, 'management-status')
            (evidence / 'host-management-final.json').write_text(json.dumps(final, indent=2))
            expected_members = {fixtures['owner']: 'OWNER', fixtures['member']: 'MEMBER'}
            expected_channels = {fixtures[name] for name in ('general', 'workshop', 'announcements')}
            if final['members'] != expected_members or set(final['channels']) != expected_channels:
                raise RuntimeError('Final independent management membership/channel scope differs')
            if any(value['archived'] for value in final['channels'].values()):
                raise RuntimeError('The actual managed channels were not reopened')
            checkpoints = [json.loads((evidence / f'checkpoint-{phase}.raw').read_bytes()) for phase in ('role-pending', 'archive-pending')]
            if final['dropped'] != [item['original'] for item in checkpoints]:
                raise RuntimeError('Actual dropped reply identities differ from checkpoints')
            for checkpoint, kind in zip(checkpoints, ('set-role', 'archive-channel')):
                rows = [row for row in final['originals'] if row['id'] == checkpoint['original']]
                if len(rows) != 2 or len({row['sha256'] for row in rows}) != 1 or any(
                        row['kind'] != kind or row['actor'] != fixtures['owner'] or row['space'] != fixtures['space'] for row in rows):
                    raise RuntimeError('Recovery did not deliver the exact accepted original twice')
            for name in ('normal-host', 'compact-host'):
                observed = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/{name}.json').stdout)
                (evidence / f'native-{name}.json').write_text(json.dumps(observed, indent=2))
                if observed['space'] != final['space'] or observed['members'] != final['members'] or observed['channels'] != final['channels']:
                    raise RuntimeError('Native and independent final management state differ')
                if name == 'compact-host' and observed != final:
                    raise RuntimeError('Native compact and final host observations differ')
                if name == 'normal-host' and observed['originals'] != final['originals'][:len(observed['originals'])]:
                    raise RuntimeError('Native normal observation is not the actual received prefix')
            for name, pid in (('role', pids[0]), ('archive', pids[2]), ('compact-role', pids[3])):
                cleanup = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/cleanup-{name}.json').stdout)
                (evidence / f'local-fault-cleanup-{name}.json').write_text(json.dumps(cleanup, indent=2))
                if cleanup != {'removed': True, 'pid': pid, 'space': fixtures['space'], 'owner': fixtures['owner']}:
                    raise RuntimeError('An owned local write fault was not independently removed')
        else:
            fixtures = command(control_port, 'fixtures')
            cold_public = command(control_port, 'cached-public-observation')
            (evidence / 'host-cold-public-cache.json').write_text(json.dumps(cold_public, indent=2))
            observed_cold = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/cold-public-cache.json').stdout)
            if observed_cold != cold_public or cold_public.get('pid') != pids[1] or cold_public.get('publicReadBarrierArmed') is not True:
                raise RuntimeError('Native and host did not confirm cached public reading before releasing the barrier')
            if cold_public.get('space') != fixtures['public']['space'] or cold_public.get('owner') != json.loads((evidence / 'checkpoint-visitor.raw').read_bytes())['owner']:
                raise RuntimeError('Cached public reading belongs to another identity or community')
            child = command(control_port, 'channel-received', {'space': fixtures['private']['space'], 'channel': 'design'})
            (evidence / 'host-private-child-received.json').write_text(json.dumps(child, indent=2))
            sender = json.loads((evidence / 'checkpoint-member.raw').read_bytes())['owner']
            matched = [row for row in child['received'] if row['author'] == sender and row['text'] == 'Private child survives invitation revocation']
            if len(matched) != 1:
                raise RuntimeError('Independent host did not decrypt exactly one intended child original')
            observed_child = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/private-child-received.json').stdout)
            if observed_child != matched[0]:
                raise RuntimeError('Native and independent host observed different child originals')
            peer_recovery = command(control_port, 'read-recovery')
            (evidence / 'host-peer-read-recovery.json').write_text(json.dumps(peer_recovery, indent=2))
            observed_recovery = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/peer-read-recovery.json').stdout)
            if observed_recovery.pop('pid') != pids[2] or observed_recovery != peer_recovery or peer_recovery.get('author') != sender:
                raise RuntimeError('Native and independent host did not confirm the same peer-read recovery')
        (evidence / 'host-status.json').write_text(json.dumps(command(control_port, 'status')))
        command(control_port, 'stop'); host.wait(timeout=15)
        if host.returncode:
            raise RuntimeError(f'Owned {label} host failed its actual effects/cleanup')
        (evidence / 'journey-outcome.json').write_text(json.dumps({'source': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo).decode().strip(),
            'phasePids': pids, 'nativeTerminalPasses': 2, 'deliberatelyInterruptedCases': 2,
            'productionNodeActivated': False, 'ordinaryBetaChanged': False}))
    else:
        record(1)
        first = instrument('createInviteJoinReadAndCheckpointAnUncertainOriginal', 'before-kill.txt', peer_port, control_port)
        deadline = time.monotonic() + 180
        while True:
            observed = adb('exec-out', 'run-as', pkg, 'cat', 'cache/spaces-journey-checkpoint.json', check=False)
            if time.monotonic() >= deadline:
                raise RuntimeError('Native create/join/checkpoint exceeded its 180-second bound')
            candidate = observed.returncode == 0 and observed.stdout.lstrip().startswith(b'{')
            with (evidence / 'checkpoint-observations.jsonl').open('a') as observations:
                observations.write(json.dumps({'remainingSeconds': round(deadline - time.monotonic(), 3),
                    'exit': observed.returncode, 'bytes': len(observed.stdout), 'candidateJson': candidate,
                    'nonJsonOutput': None if candidate else observed.stdout[:360].decode('utf-8', errors='replace')}) + '\n')
            if candidate:
                # Atomic device publication makes a malformed visible checkpoint
                # an actual failure; retain its original bytes before parsing.
                (evidence / 'observed-checkpoint.raw').write_bytes(observed.stdout)
                checkpoint = json.loads(observed.stdout)
                if checkpoint['phase'] == 'ready-for-process-kill':
                    break
            if first.poll() is not None:
                raise RuntimeError('Native test ended before its checkpoint; inspect before-kill.txt')
            time.sleep(.25)
        (evidence / 'checkpoint.json').write_text(json.dumps(checkpoint))
        pid = adb('shell', 'pidof', pkg).stdout.decode().strip()
        if pid != str(checkpoint['pid']):
            raise RuntimeError('Checkpoint does not belong to the live Android process')
        adb('shell', 'am', 'force-stop', pkg)
        first.wait(timeout=15)
        if adb('shell', 'pidof', pkg, check=False).stdout.strip():
            raise RuntimeError('Original Android PID still exists')
        (evidence / 'process-kill.json').write_text(json.dumps({'oldPid': checkpoint['pid'], 'forceStopped': True,
            'firstInstrumentExit': first.returncode, 'expectedInterruptedTest': True}))
        # End the first recording using the actual device screenrecord process.
        finish_record(*movies[-1])
        record(2)
        second = instrument('coldReturnReconcilesTheSameOriginalAndKeepsNewWriting', 'after-kill.txt', peer_port, control_port)
        second.wait(timeout=90)
        if second.returncode != 0 or 'OK (1 test)' not in (evidence / 'after-kill.txt').read_text():
            raise RuntimeError('Native distinct-process recovery failed')
        (evidence / 'host-status.json').write_text(json.dumps(command(control_port, 'status')))
        command(control_port, 'stop'); host.wait(timeout=15)
        if host.returncode != 0:
            raise RuntimeError('Owned host could not verify/close actual received effects')
        recovered = json.loads(adb('exec-out', 'run-as', pkg, 'cat', 'cache/spaces-journey-evidence/recovered.json').stdout)
        if recovered['recoveredPid'] == checkpoint['pid']:
            raise RuntimeError('Recovery reused the old Android PID')
        (evidence / 'journey-outcome.json').write_text(json.dumps({'source': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo).decode().strip(),
            'oldPid': checkpoint['pid'], 'newPid': recovered['recoveredPid'], 'nativeTerminalPasses': 1,
            'deliberatelyInterruptedCases': 1, 'productionNodeActivated': False}))

finally:
    # Each bounded cleanup is independent, and its exception must not replace
    # the original native/checkpoint failure or prevent remaining teardown.
    primary = sys.exc_info()[1]
    cleanup_errors = []
    def cleanup(label, action):
        try:
            return action()
        except Exception as failure:
            cleanup_errors.append({'stage': label, 'error': type(failure).__name__})
            return None
    def capture_crash():
        (evidence / 'crash.log').write_bytes(adb('logcat', '-d', '-b', 'crash', timeout=10).stdout)
        (evidence / 'last-window.png').write_bytes(adb('exec-out', 'screencap', '-p', timeout=10).stdout)
    cleanup('failure-buffers', capture_crash)
    cleanup('fixture-account-diagnostics', lambda: (evidence / 'spaces-account.log').write_bytes(
        adb('logcat', '-d', '-v', 'threadtime', '-s', 'SpacesAccount138:D', '*:S', timeout=10).stdout))
    if primary is not None and control_port and host.poll() is None:
        def observe_host_failure():
            (evidence / 'failure-host-status.json').write_text(json.dumps(command(control_port, 'status'), indent=2))
        cleanup('independent-failure-observation', observe_host_failure)
    cleanup('stop-owned-android-process', lambda: adb('shell', 'am', 'force-stop', pkg))
    for process, remote, phase in movies:
        def stop_movie(process=process, remote=remote, phase=phase):
            try:
                if not movie_owners.get(phase, {}).get('stopped'): finish_record(process, remote, phase)
            except Exception:
                if process.poll() is None:
                    process.kill(); process.wait(timeout=5)
                raise
        cleanup(f'stop-movie-{phase}', stop_movie)
        cleanup(f'pull-movie-{phase}', lambda remote=remote, phase=phase:
            adb('pull', remote, str(evidence / f'phase-{phase}.mp4'), timeout=30))
    def archive():
        capture = adb('exec-out', 'run-as', pkg, 'tar', '-C', 'cache', '-cf', '-',
                      folder, timeout=30, check=False)
        (evidence / 'native-evidence.tar').write_bytes(capture.stdout)
        (evidence / 'native-evidence-capture.json').write_text(json.dumps({'exit': capture.returncode}))
        if capture.returncode: raise RuntimeError('Native evidence archive failed')
    cleanup('native-archive', archive)
    # Resizing a running recorder crops its projection. Restore only after all
    # recordings and native originals have been stopped, pulled and retained.
    if viewport_original is not None:
        cleanup('restore-viewport-size', lambda: adb('shell', 'wm', 'size', viewport_original['size']['override'] or 'reset'))
        cleanup('restore-viewport-density', lambda: adb('shell', 'wm', 'density', viewport_original['density']['override'] or 'reset'))
        def restore_font():
            font = viewport_original['fontSetting']
            adb('shell', 'settings', 'delete', 'system', 'font_scale') if font == 'null' else adb('shell', 'settings', 'put', 'system', 'font_scale', font)
        cleanup('restore-viewport-font', restore_font)
        cleanup('verify-restored-viewport', verify_restored_viewport)
        cleanup('stop-viewport-probe', lambda: adb('shell', 'am', 'force-stop', pkg))
    if control_port and host.poll() is None:
        cleanup('stop-owned-host', lambda: command(control_port, 'stop'))
    for process, log in reversed(children):
        def stop_child(process=process, log=log):
            try:
                if process.poll() is None:
                    process.terminate()
                    try: process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        process.kill(); process.wait(timeout=5)
            finally: log.close()
        cleanup('owned-child', stop_child)
    if control_port:
        for port in (peer_port, control_port):
            cleanup(f'reverse-{port}', lambda port=port: adb('reverse', '--remove', f'tcp:{port}'))
    if 'hostroot' in globals():
        for name in ('ready.json', 'result.json', 'host.log'):
            def copy_host(name=name):
                path = hostroot / name
                if path.exists(): (evidence / ('host-' + name)).write_bytes(path.read_bytes())
            cleanup('host-observation-' + name, copy_host)
    (evidence / 'cleanup.json').write_text(json.dumps({'originalFailure': type(primary).__name__ if primary else None,
                                                     'errors': cleanup_errors}, indent=2))
    if primary is None and not cleanup_errors:
        (evidence / 'acceptance.json').write_bytes((evidence / 'journey-outcome.json').read_bytes())
    files = []
    for path in sorted(evidence.rglob('*')):
        if path.is_file():
            with path.open('rb') as content:
                hasher = hashlib.sha256()
                for chunk in iter(lambda: content.read(1024 * 1024), b''):
                    hasher.update(chunk)
                digest = hasher.hexdigest()
            files.append({'path': str(path.relative_to(evidence)), 'bytes': path.stat().st_size, 'sha256': digest})
    (evidence / 'files.json').write_text(json.dumps(files, indent=2))
    if primary is None and cleanup_errors:
        raise RuntimeError('Native journey cleanup failed; inspect cleanup.json')
