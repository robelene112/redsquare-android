            if final['space'] != fixtures['space'] or final['privateChannel'] != channel or len(final['members']) != 26:
                raise RuntimeError('Independent private management scope differs')
            if final['members'][fixtures['owner']] != 'OWNER' or final['members'][fixtures['member']] != 'MEMBER' or final['members'][fixtures['admin']] != 'ADMIN':
                raise RuntimeError('Private channel actions changed Space roles')
            if set(final['channels']) != {fixtures['general'], channel} or final['channels'][channel] != {
                    'name': 'native-private-lounge', 'category': 'Team', 'ready': True, 'visibility': 'PRIVATE'}:
                raise RuntimeError('Independent reader did not obtain the intended private channel')
            if final['outsiderChannels'] != [fixtures['general']]:
                raise RuntimeError('Unauthorized member received a private channel name or preview')
            if final['privateMessages'] != ['A native encrypted message before removal', 'A native encrypted message after fresh admission']:
                raise RuntimeError('Independent encrypted reading did not survive fresh admission')
            creation = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/private-creation-recovery.json').stdout)
            (evidence / 'native-private-creation-recovery.json').write_text(json.dumps(creation, indent=2))
            if creation['pid'] != pids[0] or creation['owner'] != fixtures['owner'] or creation['space'] != fixtures['space'] or creation['channel'] != channel:
                raise RuntimeError('Private creation recovery scope differs')
            if not (0 < creation['recoveryStartedAtMs'] <= creation['recoveryCompletedAtMs'] <= creation['recoveryStartedAtMs'] + 27_000):
                raise RuntimeError('Private creation exceeded its complete27second deadline')
            checkpoints = [json.loads((evidence / f'checkpoint-{phase}.raw').read_bytes()) for phase in ('private-revoke-pending', 'private-grant-pending')]
            editing = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/private-edit-recovery.json').stdout)
            (evidence / 'native-private-edit-recovery.json').write_text(json.dumps(editing, indent=2))
            if any(editing[key] != value for key, value in {'pid': pids[2], 'owner': fixtures['owner'], 'space': fixtures['space'],
                    'channel': channel, 'name': 'native-private-reading', 'category': 'Shared plans'}.items()):
                raise RuntimeError('Private encrypted edit recovery scope differs')
            if not (0 < editing['recoveryStartedAtMs'] <= editing['recoveryCompletedAtMs'] <= editing['recoveryStartedAtMs'] + 27_000):
                raise RuntimeError('Private metadata exceeded the original27second recovery goal')
            if final['dropped'] != [creation['original']] + [item['original'] for item in checkpoints] + [editing['original']]:
                raise RuntimeError('Private lost-reply identities differ')
            if len(final['originals']) != 9: raise RuntimeError('Unexpected private management original count')
            edits = [row for row in final['originals'] if row['kind'] == 'edit-channel']
            retried = [row for row in edits if row['id'] == editing['original']]
            restored = [row for row in edits if row['id'] != editing['original']]
            if len(edits) != 3 or len(retried) != 2 or len(restored) != 1 or len({row['sha256'] for row in retried}) != 1 or any(
                    row['actor'] != fixtures['owner'] or row['space'] != fixtures['space'] or row['channel'] != channel or row['privateMetadata'] is not True for row in edits):
                raise RuntimeError('Private encrypted edit did not preserve exact original recovery and a separate restoration')
            edited_host = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/private-edit-host.json').stdout)
            (evidence / 'native-private-edit-host.json').write_text(json.dumps(edited_host, indent=2))
            if edited_host['channels'][channel] != {'name': 'native-private-reading', 'category': 'Shared plans', 'ready': True, 'visibility': 'PRIVATE'} or any(
                    edited_host[key] != final[key] for key in ('space', 'members', 'outsiderChannels', 'privateMessages', 'dropped')) or edited_host['originals'] != final['originals'][:8]:
                raise RuntimeError('Independent private renamed state did not preserve roles, privacy and message history')
            for original, kind in zip(final['dropped'][:3], ('create-channel', 'revoke-channel-access', 'grant-channel-access')):
                rows = [row for row in final['originals'] if row['id'] == original]
                if len(rows) != 2 or len({row['sha256'] for row in rows}) != 1 or any(
                        row['kind'] != kind or row['actor'] != fixtures['owner'] or row['space'] != fixtures['space'] or row['channel'] != channel for row in rows):
                    raise RuntimeError('Private recovery did not deliver the same accepted original exactly twice')
                if kind == 'create-channel' and any(row['visibility'] != 'private' or row['allowedMembers'] != [fixtures['member']] for row in rows):
                    raise RuntimeError('Private creation did not preserve exactly the selected member')
                if kind == 'revoke-channel-access' and any(row['epoch'] != 2 or row['deviceCount'] != 1 for row in rows):
                    raise RuntimeError('Revocation did not remove the actually admitted reader device')
            for name in ('normal-host', 'compact-host'):
                observed = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/{name}.json').stdout)
                (evidence / f'native-{name}.json').write_text(json.dumps(observed, indent=2))
                if observed != final: raise RuntimeError('Native and independent final private effects differ')
            for name, pid in (('private-access', pids[2]), ('compact-private-access', pids[3])):
                cleanup = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/cleanup-{name}.json').stdout)
                (evidence / f'local-fault-cleanup-{name}.json').write_text(json.dumps(cleanup, indent=2))
                if cleanup != {'removed': True, 'pid': pid, 'space': fixtures['space'], 'owner': fixtures['owner']}:
                    raise RuntimeError('Private local fault was not independently cleaned')
            reading_names = ('compact-before-access', 'compact-before-close', 'compact-after-close',
                'compact-return-before-wait', 'compact-return-confirmed')
            for name in reading_names:
                observed = json.loads(adb('exec-out', 'run-as', pkg, 'cat', f'cache/{folder}/reading-{name}.json').stdout)
                (evidence / f'native-reading-{name}.json').write_text(json.dumps(observed, indent=2))
                if any(observed[key] != value for key, value in {'pid': pids[3], 'owner': fixtures['owner'],
                        'space': fixtures['space'], 'channel': channel, 'selectedChannel': channel}.items()):
                    raise RuntimeError('Compact reading observation has a different actual account/channel/process')
                if not (0 < observed['visibleObservedAtMs'] <= observed['storeObservedAtMs']):
                    raise RuntimeError('Compact reading observation lacks actual timestamps')
                if observed['uiAvailable'] != (name != 'compact-after-close'):
                    raise RuntimeError('Compact reading observation misstates Activity availability')
                if observed['storedFollowLatest'] != (observed['anchor'] is None):
                    raise RuntimeError('Stored follow-latest does not match the actual anchor')
                if name == 'compact-return-confirmed' and not any(row['text'] == 'A native encrypted message after fresh admission'
                        and row['bottom'] > row['top'] >= 0 for row in observed['visible']):
