#!/usr/bin/env python3
"""Observe the actual native prototype on a disposable emulator, including live design latency."""
import argparse, contextlib, http.server, json, os, re, shutil, subprocess, threading, time, urllib.request, xml.etree.ElementTree as ET
from pathlib import Path
parser=argparse.ArgumentParser();parser.add_argument('--evidence',type=Path,required=True);args=parser.parse_args()
root=Path(__file__).resolve().parent.parent;out=args.evidence.resolve();out.mkdir(parents=True,exist_ok=True)
package='nl.davidengelen.redsquare.design.dev';component=package+'/nl.davidengelen.redsquare.design.DesignActivity'
def adb(*words):return subprocess.check_output(['adb',*words],text=True,timeout=30).strip()
assert adb('get-serialno').startswith('emulator-'),'Use a disposable emulator only'
served=out/'server';served.mkdir(exist_ok=True);shutil.copyfile(root/'prototype/native-shell/design.json',served/'design.json')
class QuietHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self,*a,**kw):super().__init__(*a,directory=str(served),**kw)
    def log_message(self,*a):pass
server=http.server.ThreadingHTTPServer(('127.0.0.1',8788),QuietHandler)
threading.Thread(target=server.serve_forever,daemon=True).start()
adb('reverse','tcp:8788','tcp:8788')
def start(route='home',appearance='dark',url='http://127.0.0.1:8788/design.json'):
    adb('shell','am','force-stop',package)
    adb('shell','am','start','-n',component,'--es','designUrl',url,'--es','route',route,'--es','appearance',appearance)
def tree():
    adb('shell','rm','-f','/sdcard/design-window.xml')
    adb('shell','uiautomator','dump','/sdcard/design-window.xml')
    return ET.fromstring(adb('shell','cat','/sdcard/design-window.xml'))
def wait(text,desc=False,timeout=25,contains=False):
    end=time.monotonic()+timeout
    while time.monotonic()<end:
        try:
            t=tree()
            found=[x for x in t.iter('node') if (text in x.get('content-desc' if desc else 'text','') if contains else x.get('content-desc' if desc else 'text')==text)]
            if found:return found[0]
        except (ET.ParseError,subprocess.CalledProcessError,subprocess.TimeoutExpired):pass
        time.sleep(.2)
    raise AssertionError('Native control not found: '+text)
def tap(text,desc=False):
    node=wait(text,desc);bounds=list(map(int,re.findall(r'\d+',node.get('bounds'))));adb('shell','input','tap',str((bounds[0]+bounds[2])//2),str((bounds[1]+bounds[3])//2))
def type_text(text):
    # input text emits a burst of synthetic key events, unlike an IME commit.
    # Pace those events so the disposable emulator can process each edit.
    assert re.fullmatch(r'[a-z-]+',text)
    for character in text:
        adb('shell','input','text',character)
        time.sleep(.1)
def scroll_tap(text):
    size=list(map(int,re.findall(r'\d+',adb('shell','wm','size').splitlines()[-1])))
    width,height=size[-2:]
    for attempt in range(12):
        for node in tree().iter('node'):
            if node.get('text')==text:
                bounds=list(map(int,re.findall(r'\d+',node.get('bounds'))))
                if bounds[3]>bounds[1] and 80<(bounds[1]+bounds[3])/2<height-20:
                    adb('shell','input','tap',str((bounds[0]+bounds[2])//2),str((bounds[1]+bounds[3])//2));return
        adb('shell','input','swipe',str(int(width*.90)),str(int(height*.77)),str(int(width*.90)),str(int(height*.30)),'350')
    raise AssertionError('Scrollable native control not found: '+text)
def capture(name):
    (out/(name+'.xml')).write_text(ET.tostring(tree(),encoding='unicode'))
    with (out/(name+'.png')).open('wb') as f:subprocess.run(['adb','exec-out','screencap','-p'],stdout=f,check=True)
try:
    start();wait('Red Square');capture('home-dark')
    timing=[]
    original=json.loads((served/'design.json').read_text())
    for n in range(3):
        update=json.loads(json.dumps(original));update['revision']='observed-live-'+str(n);update['modules']['redsquare']['title']='Red Square Live '+str(n)
        deviceBefore=float(adb('shell','cat','/proc/uptime').split()[0])*1000
        before=time.monotonic()
        tmp=served/'design.new';tmp.write_text(json.dumps(update));tmp.replace(served/'design.json')
        wait('Red Square Live '+str(n))
        observed=(time.monotonic()-before)*1000
        logs=adb('logcat','-d','-s','ShellPreview:I','*:S')
        matches=re.findall(r'design_frame revision=observed-live-'+str(n)+r' elapsedMs=(\d+)',logs)
        assert matches,'No actual rendered-frame observation'
        timing.append(dict(revision=update['revision'],publishToFrameMs=round(int(matches[-1])-deviceBefore,1),publishToUiObservationMs=round(observed,1)))
    (out/'live-update-timing.json').write_text(json.dumps(timing,indent=2)+'\n')
    capture('live-updated-without-new-apk')
    tap('Apps',True);tap('Stack');wait('Discover');capture('stack-discover')
    tap('Write an article',True);wait('Write');capture('visual-editor')
    tap('Markdown');wait('Markdown source')
    edit=next(x for x in tree().iter('node') if x.get('class')=='android.widget.EditText' and 'A little' in x.get('text',''))
    bounds=list(map(int,re.findall(r'\d+',edit.get('bounds'))))
    adb('shell','input','tap',str((bounds[0]+bounds[2])//2),str((bounds[1]+bounds[3])//2))
    type_text('retained-draft-proof');adb('shell','input','keyevent','4')
    wait('retained-draft-proof',contains=True);capture('markdown-editor')
    tap('Apps',True);tap('Red Square Live 2');wait('Red Square Live 2')
    tap('Apps',True);tap('Stack');wait('retained-draft-proof',contains=True);capture('editor-retained-after-module-switch')
    tap('Review');wait('Review & publish');capture('publish-review')
    scroll_tap('Share to Red Square');scroll_tap('Publish preview');wait('Your story has a home.')
    tap('Apps',True);tap('Red Square Live 2')
    # Module switching preserves the old feed anchor; deliberately reveal the new post above it.
    size=list(map(int,re.findall(r'\d+',adb('shell','wm','size').splitlines()[-1])));width,height=size[-2:]
    for _ in range(8):
        if any(x.get('text')=='A new story, shared on Stack.' for x in tree().iter('node')):break
        adb('shell','input','swipe',str(int(width*.90)),str(int(height*.35)),str(int(width*.90)),str(int(height*.80)),'350')
    wait('A new story, shared on Stack.');capture('optional-article-post-created')
    start('compose');wait('New post')
    edit=next(x for x in tree().iter('node') if x.get('class')=='android.widget.EditText')
    bounds=list(map(int,re.findall(r'\d+',edit.get('bounds'))))
    adb('shell','input','tap',str((bounds[0]+bounds[2])//2),str((bounds[1]+bounds[3])//2))
    type_text('compose-draft-proof');adb('shell','input','keyevent','4')
    tap('Apps',True);tap('Stack');wait('Discover');tap('Apps',True);tap('Red Square Live 2')
    wait('compose-draft-proof',contains=True);capture('redsquare-composer-retained')
    start('locked-article');wait('Article');scroll_tap('View access options');wait('Article access')
    scroll_tap('Review access');wait('Review access');scroll_tap('Confirm preview access')
    wait('Article');scroll_tap('Access active');capture('requested-article-unlocked')
    # Returning to the original sample config is another live update, not a reinstall.
    (served/'design.json').write_text(json.dumps(original))
    routes=['thread','activity','conversation','profile','wallet','receive','settings','node-settings','article','locked-article','access-review','editor','publish-review','subscriptions','design-settings']
    for route in routes:
        start(route);wait('Apps',True);capture(route+'-dark')
    start('home','light');wait('Red Square');capture('home-light')
    start('stack','light');wait('Discover');capture('stack-light')
    # Real HTTPS feed lives on David's VPS, independently of the local fixture.
    publicUrl='https://davidengelen.nl/redsquare/design/proof/design.json'
    start('home',url=publicUrl);wait('Apps',True)
    public=[]
    def remote():
        begin=time.monotonic()
        request=urllib.request.Request(publicUrl+'?observe='+str(time.time_ns()),headers={'User-Agent':'redsquare-design-observer/1'})
        with urllib.request.urlopen(request,timeout=10) as response: data=json.load(response)
        return data,begin,time.monotonic()
    previous,previousStart,_=remote()
    for n in range(3):
        before=time.monotonic();deviceMs=float(adb('shell','cat','/proc/uptime').split()[0])*1000;after=time.monotonic()
        offsetLow=before-deviceMs/1000-.01;offsetHigh=after-deviceMs/1000+.01
        deadline=time.monotonic()+25
        while True:
            data,requestStart,requestEnd=remote()
            if data['revision']!=previous['revision']:break
            previousStart=requestStart
            if time.monotonic()>deadline:raise AssertionError('Public VPS proof feed did not change')
            time.sleep(.2)
        publicationLow=previousStart;publicationHigh=requestEnd
        wait(data['modules']['redsquare']['title'])
        logs=adb('logcat','-d','-s','ShellPreview:I','*:S')
        frames=re.findall('design_frame revision='+re.escape(data['revision'])+r' elapsedMs=(\d+)',logs)
        assert frames,'No public HTTPS design frame'
        frame=int(frames[-1])/1000
        public.append(dict(revision=data['revision'],publicationToFrameLowerMs=round(max(0,(frame+offsetLow-publicationHigh)*1000),1),publicationToFrameUpperMs=round(max(0,(frame+offsetHigh-publicationLow)*1000),1),publicationBracketMs=round((publicationHigh-publicationLow)*1000,1)))
        previous=data;previousStart=requestStart
    capture('actual-vps-https-live-update')
    (out/'public-vps-timing.json').write_text(json.dumps(public,indent=2)+'\n')
    print('PUBLIC VPS HTTPS:',json.dumps(public))
    adb('shell','settings','put','system','font_scale','1.5')
    start('home');wait('Apps',True);capture('home-large-text')
    adb('shell','settings','put','system','font_scale','1.0')
    adb('shell','wm','size','1080x2400');adb('shell','wm','density','420')
    start('home');wait('Red Square');capture('home-pixel7-viewport')
    start('stack');wait('Discover');capture('stack-pixel7-viewport')
    (out/'live-update-timing.json').write_text(json.dumps(timing,indent=2)+'\n')
    (out/'logcat.txt').write_text(adb('logcat','-d','-s','ShellPreview:I','AndroidRuntime:E','*:S'))
    print('PASS: actual native shell navigation, retained editor, 3 live updates, and screenshots')
    print(json.dumps(timing))
finally:
    try:
        (out/'runtime-final.txt').write_text(adb('logcat','-d','-s','ShellPreview:I','AndroidRuntime:E','*:S'))
        with (out/'last-display.png').open('wb') as image:subprocess.run(['adb','exec-out','screencap','-p'],stdout=image,check=True,timeout=30)
        capture('final-native-state')
    except Exception as diagnostic:
        (out/'diagnostic-error.txt').write_text(str(diagnostic))
    try:
        adb('shell','settings','put','system','font_scale','1.0');adb('shell','wm','size','reset');adb('shell','wm','density','reset')
    finally: server.shutdown()
