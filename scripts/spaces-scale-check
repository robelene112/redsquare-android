#!/usr/bin/env python3
"""Check a signed Spaces fixture in the isolated profileable Android application."""
import argparse
from contextlib import nullcontext
import hashlib
import json
from pathlib import Path
import re
import shlex
import shutil
import sqlite3
import subprocess
import tempfile
import time
import urllib.request
from xml.etree import ElementTree
from spaces_scale_timing import (FRAME_TIMELINE_TRACE, TRACE_TARGET, analyse_trace, anchor_command_args, anchor_frames,
                                capture_trace, complete_anchor_coverage, diagnose_scroll, fresh_hierarchy, measure, moving_frames,
                                unexplained_displacement)

repo = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('evidence', type=Path)
parser.add_argument('apk', type=Path)
mode = parser.add_mutually_exclusive_group()
mode.add_argument('--full', action='store_true')
mode.add_argument('--diagnostic', type=Path, metavar='BUILD_CHECKOUT')
options = parser.parse_args()
evidence = options.evidence.resolve()
apk = options.apk.resolve()
full = options.full
build = options.diagnostic.resolve() if options.diagnostic else repo
tests = build / 'app/build/outputs/apk/androidTest/performance/app-performance-androidTest.apk'
package = 'nl.davidengelen.redsquare.performance'
test_package = package + '.test'
android = '{http://schemas.android.com/apk/res/android}'
classpath = (repo / 'spaces-service/build/host-fixture-classpath.txt').read_text().strip()
native = repo / 'core/build/generated/spaces-mls-host'
contract = repo / 'docs/quality/SPACES_SCALE_CONTRACT.json'
baseline = repo / 'docs/quality/SPACES_SCALE_REFERENCE.json'

def adb(*parts, timeout=25):
    return subprocess.run(['adb', *parts], check=True, capture_output=True, timeout=timeout).stdout

def sha(path):
    with path.open('rb') as content:
        return hashlib.file_digest(content, 'sha256').hexdigest()

if not adb('get-serialno').decode().strip().startswith('emulator-'):
    raise RuntimeError('Scale proof requires a disposable emulator')
evidence.mkdir(parents=True, exist_ok=False)
parsed = ElementTree.fromstring(subprocess.check_output(['apkanalyzer', 'manifest', 'print', str(apk)]))
app = parsed.find('application')
if parsed.get('package') != package or app.get(android + 'debuggable') == 'true' or app.find('profileable').get(android + 'shell') != 'true':
    raise RuntimeError('Scale fixture requires the isolated nondebuggable profileable build')

fixture_kind = 'full' if full else 'diagnostic' if options.diagnostic else 'smoke'
seed = repo / '.scratch' / f'scale-{fixture_kind}-fixture'
java = ['java', '-Xmx640m', f'-Djava.library.path={native}', '-cp', classpath]
prefix = 'nl.davidengelen.redsquare.spaces.service.'
if not options.diagnostic or not seed.exists():
    with (evidence / 'seed.log').open('wb') as seed_log:
        command = java + [prefix + 'SpacesScaleSeeder', str(seed), str(contract)]
        subprocess.run(command if full else command + [f'--{fixture_kind}'],
                       timeout=3600 if full else 180 if options.diagnostic else 90,
                       check=True, stdout=seed_log, stderr=subprocess.STDOUT)
manifest = json.loads((seed / 'fixture.json').read_text())
if manifest['contractSha256'] != sha(contract) or manifest['qualifiesForTimedRuns'] != full:
    raise RuntimeError('Unexpected calibration fixture')
if options.diagnostic and (manifest['spaces'], manifest['hotChannelMessages']) != (12, 384):
    raise RuntimeError('Unexpected diagnostic dataset')
(evidence / 'fixture.json').write_bytes((seed / 'fixture.json').read_bytes())
host_dir = tempfile.TemporaryDirectory(prefix='spaces-diagnostic-') if options.diagnostic else nullcontext()
with host_dir as temporary, (evidence / 'host.log').open('wb') as host_log:
    fixture = Path(temporary) / 'fixture' if temporary else seed
    if temporary:
        shutil.copytree(seed, fixture)
    host = subprocess.Popen(java + [prefix + 'SpacesScaleHost', str(fixture)], stdout=host_log, stderr=subprocess.STDOUT)
    local_port = None
    stopping = None
    try:
        deadline = time.monotonic() + 45
        ready = fixture / 'host-ready.json'
        while not ready.exists():
            if host.poll() is not None or time.monotonic() >= deadline:
                raise RuntimeError('Owned scale host did not become ready')
            time.sleep(.1)
        endpoints = json.loads(ready.read_text())
        local_port = endpoints['peerPort']

        def request(action):
            url = f"http://127.0.0.1:{endpoints['controlPort']}/{action}"
            with urllib.request.urlopen(urllib.request.Request(url, b'{}'), timeout=8) as response:
                return json.load(response)

        stopping = lambda: request('stop')
        if f'package:{package}' in adb('shell', 'pm', 'list', 'packages', package).decode().splitlines():
            raise RuntimeError('Scale fixture requires a clean isolated package')
        adb('reverse', f'tcp:{local_port}', f'tcp:{local_port}')
        for setting in ('window_animation_scale', 'transition_animation_scale', 'animator_duration_scale'):
            adb('shell', 'settings', 'put', 'global', setting, '1')
        adb('shell', 'wm', 'size', '824x1836')
        adb('shell', 'wm', 'density', '320')
        adb('shell', 'settings', 'put', 'system', 'font_scale', '1.0')
        adb('shell', 'cmd', 'uimode', 'night', 'no')
        adb('install', str(apk), timeout=100)
        adb('install', str(tests), timeout=100)
        transfer = f'/sdcard/Android/media/{package}/spaces-scale'
        adb('shell', 'mkdir', '-p', transfer)
        for name in ('fixture.json', 'fixture-author.sqlite'):
            adb('push', str(fixture / name), f'{transfer}/{name}', timeout=180 if full else 45)
        fixture_database = fixture / 'fixture-author.sqlite'
        with sqlite3.connect(fixture_database.as_uri() + '?mode=ro', uri=True) as database:
            expected_rows = database.execute('SELECT count(*) FROM entries').fetchone()[0]
        arguments = ['am', 'instrument', '-w', '-r',
                     '-e', 'class', 'nl.davidengelen.redsquare.SpacesScaleSeedObserver#importReleaseScaleFixture',
                     '-e', 'spacesScalePort', str(local_port),
                     '-e', 'spacesScaleDatabaseSha256', sha(fixture_database),
                     '-e', 'spacesScaleDatabaseRows', str(expected_rows),
                     f'{test_package}/androidx.test.runner.AndroidJUnitRunner']
        # Provisioning writes the full encrypted cache through Android Keystore
        # before the timed cold launch. Retain its progress even if setup expires.
        seed_output = evidence / 'seed-native.txt'
        with seed_output.open('wb') as seed_log:
            subprocess.run(['adb', 'shell', shlex.join(arguments)], check=True,
                           stdout=seed_log, stderr=subprocess.STDOUT, timeout=3000 if full else 180)
        imported = seed_output.read_text()
        observed = re.findall(r'^INSTRUMENTATION_STATUS: spacesScaleSeed=(.*)$', imported, re.M)
        if len(observed) != 1 or not re.search(r'^OK \(1 test\)\s*$', imported, re.M):
            raise RuntimeError('The profileable application did not import the signed fixture')
        receipt = json.loads(observed[0])
        if receipt['manifestSha256'] != sha(fixture / 'fixture.json') or receipt['authenticatedLocalRows'] != expected_rows:
            raise RuntimeError('Android imported a different fixture')
        launch = ['am', 'start', '-W', '-a', 'android.intent.action.VIEW', '-d', endpoints['hotLink'],
                  '-p', package, '--es', 'feedPeerUrl', f'ws://127.0.0.1:{local_port}/wsopen']
        def open_fixture(open_log, screen_log, seconds, cold=True):
            if cold:
                adb('shell', 'am', 'force-stop', package)
            reads_before_open = request('status')['readRequests']
            (evidence / open_log).write_bytes(adb('shell', shlex.join(launch), timeout=seconds))
            deadline = time.monotonic() + seconds
            latest = f"record {manifest['hotChannelMessages']}.".encode()
            while True:
                document = fresh_hierarchy(adb, '/sdcard/spaces-scale-smoke.xml', evidence / screen_log)
                if (document is not None and b'Benchmark Space 001' in document and latest in document and
                        (not cold or request('status')['readRequests'] > reads_before_open)):
                    return
                if time.monotonic() >= deadline:
                    raise RuntimeError('Cold launch did not render the signed latest fixture message')
                time.sleep(.2)

        open_fixture('external-open.txt', 'actual-screen.xml', 40)
        pid = int(adb('shell', 'pidof', package).decode().strip())
        if pid == receipt['pid']:
            raise RuntimeError('The seed process survived the cold launch')
        (evidence / 'actual-screen.png').write_bytes(adb('exec-out', 'screencap', '-p'))
        summary = {
            'source': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=build, text=True).strip(),
            'apkSha256': sha(apk), 'testApkSha256': sha(tests), 'seed': receipt, 'appPid': pid,
            'independentArrival': None if options.diagnostic else request('arrival'),
            'nativeAndIndependentService': request('status'),
            'device': adb('shell', 'getprop', 'ro.build.fingerprint').decode().strip(),
            'mode': 'paired performance diagnostics only' if options.diagnostic else
                'owned release-equivalent timing' if full else 'profileable calibration only',
            'qualifiesForTimedRuns': full,
        }
        if options.diagnostic:
            reference = json.loads(baseline.read_text())
            if reference['device'] != summary['device']:
                raise RuntimeError('Diagnostic image differs from the frozen timing environment')
            summary['diagnostic'] = diagnose_scroll(adb, evidence, package, open_fixture,
                json.loads(contract.read_text())['thresholds'])
        elif full:
            reference = json.loads(baseline.read_text())
            if reference['device'] != summary['device'] or reference['fixtureContractSha256'] != sha(contract):
                raise RuntimeError('The paced workload does not match the recorded reference environment')
            (evidence / 'scale-reference.json').write_bytes(baseline.read_bytes())
            (evidence / 'timing-inputs.json').write_text(json.dumps(summary, indent=2) + '\n')
            summary['timing'] = measure(adb, evidence, package, f'ws://127.0.0.1:{local_port}/wsopen',
                                        endpoints, manifest, json.loads(contract.read_text()), reference, request)
        else:
            def observer(operation, *extras):
                adb('shell', shlex.join(anchor_command_args(package, operation, *extras)))

            def observe_anchor(filename, read):
                deadline = time.monotonic() + 12
                while True:
                    observed = adb('logcat', '-d', '-s', 'SpacesScaleProof:I', '*:S').decode()
                    (evidence / filename).write_text(observed)
                    result = read(observed)
                    if result is not None:
                        return result
                    if time.monotonic() >= deadline:
                        raise RuntimeError('Calibration did not observe the actual anchor frame commit')
                    time.sleep(.1)

            config = FRAME_TIMELINE_TRACE + 'duration_ms: 45000\nwrite_into_file: true\nfile_write_period_ms: 5000\n'
            # Capture the app's surface creation and let Perfetto flush the
            # terminal presented frames before the trace file is pulled.
            with capture_trace(adb, evidence, config, wait_for_duration=True):
                open_fixture('traced-external-open.txt', 'traced-screen.xml', 15)

                def fixed(checkpoint):
                    return observe_anchor('anchor-observations.txt', lambda raw: next(
                        (row for row in anchor_frames(raw, 0) if row[3] == checkpoint and row[4] is not None), None))

                observer('arm', '--ei', 'trial', '0', '--ei', 'record', str(manifest['hotChannelMessages']))
                first = fixed(False)
                observer('checkpoint')
                last = fixed(True)
                observer('stop')

                observer('arm', '--ei', 'trial', '6', '--ei', 'record', '0')
                observe_anchor('scroll-observations.txt', lambda raw: next(
                    (row for row in moving_frames(raw) if row['visibleTopsPx']), None))
                adb('shell', 'input swipe 410 620 410 1310 350')
                observer('checkpoint')

                def through_checkpoint(raw):
                    rows = moving_frames(raw)
                    for index, row in enumerate(rows):
                        if row['checkpoint']:
                            return rows[:index + 1]
                    return None

                moving = observe_anchor('scroll-observations.txt', through_checkpoint)
                observer('stop')
                # The background PID can disappear before the final service
                # flush. Require another file write after the terminal commit.
                def trace_size():
                    return int(adb('shell', 'stat', '-c', '%s', TRACE_TARGET).strip())

                initial_bytes = trace_size()
                deadline = time.monotonic() + 13
                while True:
                    updated_bytes = trace_size()
                    (evidence / 'perfetto-checkpoint-flush.txt').write_text(f'{initial_bytes} {updated_bytes}\n')
                    if updated_bytes > initial_bytes:
                        break
                    if time.monotonic() >= deadline:
                        raise RuntimeError('Perfetto did not flush another packet after the terminal calibration frame')
                    time.sleep(.2)
            native = analyse_trace(evidence, {}, [('calibration', 0, first[0], last[0]),
                ('moving-calibration', 6, moving[0]['sequence'], moving[-1]['sequence'])])
            if not complete_anchor_coverage(native, 2):
                raise RuntimeError('Calibration could not match all presented anchor frames to their geometry')
            (evidence / 'scroll-calibration.json').write_text(json.dumps(moving, indent=2) + '\n')
            displacement = unexplained_displacement(moving)
            if abs(moving[-1]['scrollPx'] - moving[0]['scrollPx']) < 5 or displacement > 2:
                raise RuntimeError('Calibration could not reconcile actual row movement with the native swipe')
            summary['committedAnchorBounds'] = last[4]
            summary['anchorCoverage'] = native['anchorCoverage']
            summary['maximumUnexplainedDisplacementPx'] = displacement
        stopping()
        stopping = None
        if host.wait(timeout=15) != 0:
            raise RuntimeError('Owned scale peer terminated with errors')
        result_name = 'diagnostic.json' if options.diagnostic else 'scale-result.json' if full else 'calibration.json'
        (evidence / result_name).write_text(json.dumps(summary, indent=2) + '\n')
    except Exception:
        captures = {
            'failure-logcat.txt': lambda: adb('logcat', '-d', '-v', 'threadtime', '-s',
                'SpacesAccount138:D', 'SpacesScaleProof:I', 'AndroidRuntime:E', '*:S'),
            'failure-screen.png': lambda: adb('exec-out', 'screencap', '-p'),
        }
        if stopping is not None:
            captures['failure-service.json'] = lambda: json.dumps(request('status'), indent=2).encode()
        for name, collect in captures.items():
            try:
                (evidence / name).write_bytes(collect())
            except (OSError, subprocess.SubprocessError) as observer_error:
                (evidence / (name + '.error')).write_text(str(observer_error))
        raise
    finally:
        if stopping is not None and host.poll() is None:
            try:
                stopping()
                host.wait(timeout=15)
            except (OSError, subprocess.TimeoutExpired):
                host.kill()
                host.wait(timeout=5)
        if local_port is not None:
            subprocess.run(['adb', 'reverse', '--remove', f'tcp:{local_port}'], check=False, timeout=10)
