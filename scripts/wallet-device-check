#!/usr/bin/env python3
"""Observe wallet identity through the UI, across cold process launches/updates."""
import argparse
from pathlib import Path
import re
import subprocess
import time
import xml.etree.ElementTree as ET

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--evidence", type=Path, required=True)
parser.add_argument("--before", type=Path)
parser.add_argument("--after", type=Path)
args = parser.parse_args()
if bool(args.before) != bool(args.after):
    parser.error("An update check requires both APKs")

def adb(*arguments):
    return subprocess.check_output(["adb", *arguments], text=True, timeout=60)

# This automation never force-stops, installs over, or modifies a physical
# owner's app. Physical acceptance is the documented manual check.
if not adb("get-serialno").strip().startswith("emulator-"):
    raise SystemExit("Run this check only on an isolated emulator")
package = "nl.davidengelen.redsquare" if args.before else "nl.davidengelen.redsquare.dev"
args.evidence.mkdir(parents=True, exist_ok=True)

def nodes():
    adb("shell", "uiautomator", "dump", "/sdcard/wallet-check.xml")
    xml = adb("shell", "cat", "/sdcard/wallet-check.xml")
    (args.evidence / "last-ui.xml").write_text(xml)
    return ET.fromstring(xml).iter("node")

def tap(node):
    bounds = re.fullmatch(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]", node.get("bounds", ""))
    if not bounds:
        raise AssertionError("Visible wallet action has no bounds")
    left, top, right, bottom = map(int, bounds.groups())
    adb("shell", "input", "tap", str((left + right) // 2), str((top + bottom) // 2))

def open_address():
    launch = ["shell", "am", "start", "-W", "-n", package + "/nl.davidengelen.redsquare.MainActivity"]
    if package.endswith(".dev"):
        launch += ["--ez", "feedDisabled", "true"]
    adb(*launch)
    for _ in range(20):
        visible = list(nodes())
        if any(node.get("text") == "System UI isn't responding" for node in visible):
            # Retain evidence and dismiss only the known emulator system dialog.
            # Red Square ANRs are never dismissed by this observer.
            wait = next((node for node in visible if node.get("text") == "Wait"), None)
            if wait is not None:
                with (args.evidence / "system-ui-wait.txt").open("a") as log:
                    log.write("Dismissed exact System UI isn't responding dialog with Wait\n")
                tap(wait)
                time.sleep(1)
                continue
        action = next((node for node in visible if node.get("text") == "Wallet"), None)
        if action is not None:
            tap(action)
            break
        time.sleep(1)
    else:
        with (args.evidence / "failure.png").open("wb") as output:
            subprocess.run(["adb", "exec-out", "screencap", "-p"], stdout=output, check=True, timeout=60)
        raise AssertionError("Wallet action unavailable")
    for _ in range(20):
        address = next((node.get("text") for node in nodes()
                        if node.get("content-desc") == "Wallet address"), None)
        if address:
            if not re.fullmatch(r"[1-9A-HJ-NP-Za-km-z]{44}", address):
                raise AssertionError("Fresh wallet address is invalid")
            return address
        time.sleep(1)
    raise AssertionError("Wallet did not open")

if args.before:
    adb("install", "-r", str(args.before))
adb("shell", "am", "force-stop", package)
address = open_address()
adb("shell", "am", "force-stop", package)
cold_address = open_address()
if cold_address != address:
    raise AssertionError("Wallet identity changed after process termination")
if args.after:
    adb("shell", "am", "force-stop", package)
    adb("install", "-r", str(args.after))
    updated_address = open_address()
    if updated_address != address:
        raise AssertionError("Wallet identity changed after ordinary APK update")
    adb("shell", "am", "force-stop", package)
    if open_address() != address:
        raise AssertionError("Updated wallet identity changed after another cold launch")
with (args.evidence / "wallet.png").open("wb") as output:
    subprocess.run(["adb", "exec-out", "screencap", "-p"], stdout=output, check=True, timeout=60)
(args.evidence / "continuity.txt").write_text(
    "PASS: same public identity after cold process launch" +
    (" and ordinary signed APK update" if args.after else "") + "\n" + address + "\n")
print("PASS: wallet UI continuity")
