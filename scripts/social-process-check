#!/usr/bin/env python3
"""Kill the app after Like sends and verify another tap works after cold restart."""
import argparse
import json
from pathlib import Path
import re
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--evidence", type=Path, required=True)
parser.add_argument("--repeat", action="store_true", help="Verify repeated Likes across process death")
args = parser.parse_args()
package = "nl.davidengelen.redsquare.dev"
runner = package + ".test/androidx.test.runner.AndroidJUnitRunner"
test_class = "nl.davidengelen.redsquare." + ("RepeatLikeProcessRecoveryTest" if args.repeat else "SocialProcessRecoveryTest")
prepare_method = "terminateAfterTwoSentLikes" if args.repeat else "terminateAfterSentLike"
recover_method = "coldStartupAllowsAnotherLikeWithoutWaitingForTheEarlierConfirmation" if args.repeat else "coldStartupAllowsAnotherLikeWithoutConfirmationUi"
evidence_folder = "repeat-social-process-evidence" if args.repeat else "social-process-evidence"


def adb(*arguments, check=True, timeout=60):
    return subprocess.run(["adb", *arguments], text=True, capture_output=True,
                          check=check, timeout=timeout)


if not adb("get-serialno").stdout.strip().startswith("emulator-"):
    raise SystemExit("This process check requires an isolated emulator")
args.evidence.mkdir(parents=True, exist_ok=True)
state_path = "cache/" + ("repeat-social-process-checkpoint.json" if args.repeat else "social-process-checkpoint.json")
adb("shell", "run-as", package, "rm", "-f", state_path)
try:
    prepared = adb("shell", "am", "instrument", "-w", "-r", "-e", "class",
                   test_class + "#" + prepare_method, runner,
                   check=False, timeout=120)
    (args.evidence / "interrupted-instrumentation.txt").write_text(prepared.stdout)
    if "FAILURES!!!" in prepared.stdout:
        raise AssertionError("Social action preparation failed before deliberate termination; see interrupted-instrumentation.txt")
    row = json.loads(adb("exec-out", "run-as", package, "cat", state_path).stdout)
    if not re.fullmatch(r"[1-9A-HJ-NP-Za-km-z]{43,45}", row["field2"]):
        raise AssertionError("Public social action checkpoint identity is invalid")
    if not re.fullmatch(r"[0-9a-f]{128}", row["sig"]):
        raise AssertionError("Public social action checkpoint signature is invalid")
    if args.repeat and (not re.fullmatch(r"[0-9a-f]{128}", row["previousSig"]) or row["previousSig"] == row["sig"]):
        raise AssertionError("Repeat preparation must retain two distinct actual originals")
    if str(row["pid"]) in adb("shell", "pidof", package, check=False).stdout.split():
        raise AssertionError("Social action process was not actually terminated")
    adb("shell", "am", "force-stop", package)
    recovered = adb("shell", "am", "instrument", "-w", "-r", "-e", "class",
                    test_class + "#" + recover_method, runner,
                    timeout=120)
    (args.evidence / "recovered-instrumentation.txt").write_text(recovered.stdout)
    if "OK (1 test)" not in recovered.stdout:
        raise AssertionError("Cold social action reconciliation did not pass")
    image_name = "new-like-after-restart.png" if args.repeat else "another-like-after-restart.png"
    with (args.evidence / image_name).open("wb") as output:
        subprocess.run(["adb", "exec-out", "run-as", package, "cat",
                        "cache/" + evidence_folder + "/" + image_name],
                       stdout=output, check=True, timeout=60)
    new_like_filename = "recovery-like-id.txt" if args.repeat else "next-like-id.txt"
    new_like_id = adb("exec-out", "run-as", package, "cat",
                      "cache/" + evidence_folder + "/" + new_like_filename).stdout.strip()
    earlier_ids = {row["sig"]}
    if args.repeat:
        earlier_ids.add(row["previousSig"])
    if not re.fullmatch(r"[0-9a-f]{128}", new_like_id) or new_like_id in earlier_ids:
        raise AssertionError("A post-restart tap must send a new distinct Like")
    if args.repeat:
        recovered_pid = int(adb("exec-out", "run-as", package, "cat",
                                "cache/" + evidence_folder + "/recovery-pid.txt").stdout.strip())
        if recovered_pid <= 0 or recovered_pid == row["pid"]:
            raise AssertionError("Repeat reconciliation must run in a distinct actual process")
        (args.evidence / "process-identities.json").write_text(json.dumps({
            "interruptedPid": row["pid"], "recoveredPid": recovered_pid,
            "previousSig": row["previousSig"], "lastBeforeRestart": row["sig"],
            "firstAfterRestart": new_like_id}, indent=2) + "\n")
    (args.evidence / "continuity.txt").write_text(
        "PASS: process death after immediate Like dispatch; cold startup keeps the same wallet "
        "and accepts another distinct Like without waiting for archive confirmation.\n"
        + row["field2"] + "\n" + row["sig"] + "\n" + new_like_id + "\n")
    print("PASS: immediate repeated Like behavior across process interruption")
finally:
    # Diagnostic capture must preserve any failed preparation/reconciliation assertion.
    try:
        with (args.evidence / "images.tar").open("wb") as output:
            capture = subprocess.run(["adb", "exec-out", "run-as", package, "tar", "-C", "cache",
                                      "-cf", "-", evidence_folder], stdout=output,
                                     stderr=subprocess.PIPE, timeout=10)
        (args.evidence / "capture-status.txt").write_text(str(capture.returncode) + "\n" +
                                                        capture.stderr.decode("utf-8", errors="replace"))
    except (OSError, subprocess.TimeoutExpired) as failure:
        try:
            (args.evidence / "capture-status.txt").write_text("Synthetic capture failed: " + str(failure))
        except OSError:
            pass
