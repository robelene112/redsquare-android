# Software emulation can briefly show a System UI boot ANR. Dismiss only that
# system dialog; an application ANR remains a failure, never a successful check.
for ((attempt=0; attempt<12; attempt++)); do
    sleep 3
    timeout 60 adb shell uiautomator dump /sdcard/redsquare-ui.xml >/dev/null || continue
    adb pull /sdcard/redsquare-ui.xml "$evidence/before.xml" >/dev/null
    action=$(python3 "$repo_dir/scripts/diagnostic-ui.py" "$evidence/before.xml")
    read -r kind x y <<< "$action"
    if [[ "$kind" == run ]]; then adb shell input tap "$x" "$y"; break; fi
    if [[ "$kind" == system-wait ]]; then adb shell input tap "$x" "$y"; fi
done
[[ "${kind:-}" == run ]] || { echo 'Diagnostic action is missing' >&2; exit 1; }
for ((attempt=0; attempt<30; attempt++)); do
    adb shell uiautomator dump /sdcard/redsquare-ui.xml >/dev/null
    adb pull /sdcard/redsquare-ui.xml "$evidence/after.xml" >/dev/null
    if grep -q 'Identity created and signature verified' "$evidence/after.xml"; then break; fi
    sleep 1
done
grep -q 'Identity created and signature verified' "$evidence/after.xml"
adb exec-out screencap -p > "$evidence/diagnostic.png"
adb shell getprop ro.build.version.sdk > "$evidence/sdk.txt"
echo "PASS: native diagnostic on Android SDK $(tr -d '\r\n' < "$evidence/sdk.txt")"
