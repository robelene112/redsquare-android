grep -q Success "$evidence/fresh-commit-sync.txt"
adb shell am instrument -w -r \
    -e class nl.davidengelen.redsquare.WalletCommitSyncFailureTest \
    nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
    > "$evidence/wallet-commit-sync-ui.txt"
grep -q 'OK (1 test)' "$evidence/wallet-commit-sync-ui.txt" || retain_wallet_failure
adb shell am instrument -w -r \
    -e class nl.davidengelen.redsquare.WalletPreviewTest \
    nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
    > "$evidence/wallet-ui.txt"
if ! grep -q 'OK (3 tests)' "$evidence/wallet-ui.txt"; then
    retain_wallet_failure
fi
python3 "$repo_dir/scripts/wallet-device-check" --evidence "$evidence/wallet-cold-launch"
verify_preview_update
if [[ "${TEST_PUBLIC_SIGNED_UPDATE:-0}" == 1 ]]; then
    python3 "$repo_dir/scripts/ci-review-update" 5 8 --evidence "$evidence/signed-update"
fi
verify_final_diagnostic

if [[ "${TEST_SCOPE:-full}" == full ]]; then
    printf '%s\n' "$partition" > "$evidence/partition-complete.txt"
fi
