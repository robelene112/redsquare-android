        > "$evidence/preview-update-ui.txt"
    mkdir -p "$evidence/preview-update"
    adb exec-out run-as nl.davidengelen.redsquare.dev cat cache/preview-update-evidence/requests.txt > "$evidence/preview-update/requests.txt" || true
    adb exec-out run-as nl.davidengelen.redsquare.dev cat cache/preview-update-evidence/screen.png > "$evidence/preview-update/screen.png" || true
    grep -q 'OK (1 test)' "$evidence/preview-update-ui.txt"
}
if [[ "${TEST_SCOPE:-full}" == update-android17 ]]; then
    verify_preview_update
    printf '%s\n' 'Focused update-notice check only; full feed/wallet/signed-update acceptance not run.' > "$evidence/scope.txt"
    exit 0
fi
adb shell am instrument -w -r \
    -e class nl.davidengelen.redsquare.FeedPreviewTest,nl.davidengelen.redsquare.BackendPreviewTest \
    nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
    > "$evidence/feed-ui.txt"
adb exec-out run-as nl.davidengelen.redsquare.dev cat cache/backend-ui-evidence/screen.png > "$evidence/backend-ui-screen.png" || true
adb exec-out run-as nl.davidengelen.redsquare.dev tar -C cache -cf - backend-ui-evidence > "$evidence/backend-ui-evidence.tar" || true
if ! grep -Eq 'OK \([1-9][0-9]* tests?\)' "$evidence/feed-ui.txt"; then
    adb exec-out run-as nl.davidengelen.redsquare.dev cat cache/feed-ui-failure.png > "$evidence/feed-ui-failure.png" || true
    adb exec-out run-as nl.davidengelen.redsquare.dev tar -C cache -cf - feed-ui-failures > "$evidence/feed-ui-failures.tar" || true
    exit 1
fi
python3 "$repo_dir/scripts/feed-device-check" --evidence "$evidence/feed-cold-launch"
if [[ "${TEST_PUBLIC_FEED_READ:-0}" == 1 ]]; then
    [[ "$(adb get-serialno)" == emulator-* ]] || { echo 'An isolated emulator is required' >&2; exit 1; }
    for backend in owner official; do
        adb shell pm clear nl.davidengelen.redsquare.dev > "$evidence/fresh-live-$backend.txt"
        grep -q Success "$evidence/fresh-live-$backend.txt"
        adb logcat -c
        adb shell am instrument -w -r \
            -e class nl.davidengelen.redsquare.OwnerLiveFeedTest -e publicFeedRead 1 -e publicBackend "$backend" \
            nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
            > "$evidence/live-$backend-feed.txt"
        mkdir -p "$evidence/live-$backend"
        adb exec-out run-as nl.davidengelen.redsquare.dev cat cache/live-feed-evidence/screen.png > "$evidence/live-$backend/screen.png" || true
        adb exec-out run-as nl.davidengelen.redsquare.dev cat cache/live-feed-evidence/feed.png > "$evidence/live-$backend/feed.png" || true
        adb logcat -d -v brief RedSquarePeer:W '*:S' > "$evidence/live-$backend/transport-status.txt"
        grep -q 'OK (1 test)' "$evidence/live-$backend-feed.txt"
        adb exec-out run-as nl.davidengelen.redsquare.dev cat cache/live-feed-evidence/result.txt > "$evidence/live-$backend/result.txt"
    done
fi
if [[ "${TEST_SCOPE:-full}" == feed* ]]; then
    printf '%s\n' 'Focused feed check only; full Android/wallet/update acceptance not run.' > "$evidence/scope.txt"
    exit 0
fi
adb shell am instrument -w -r \
    -e class nl.davidengelen.redsquare.NativeCompatibilityTest \
    nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
    > "$evidence/instrumentation.txt"
grep -q 'OK (3 tests)' "$evidence/instrumentation.txt"
retain_wallet_failure() {
    adb exec-out run-as nl.davidengelen.redsquare.dev cat cache/wallet-ui-failure.png > "$evidence/wallet-ui-failure.png" || true
    exit 1
}
for scenario in incompleteFirstWriteCanResumeCreation validSaveBeforePublicationResumesTheSavedIdentity unavailablePendingSaveIsPreservedForRetry; do
    [[ "$(adb get-serialno)" == emulator-* ]] || { echo 'An isolated emulator is required' >&2; exit 1; }
    adb shell pm clear nl.davidengelen.redsquare.dev > "$evidence/fresh-$scenario.txt"
    grep -q Success "$evidence/fresh-$scenario.txt"
    adb shell am instrument -w -r \
        -e class "nl.davidengelen.redsquare.WalletInterruptedInitializationTest#$scenario" \
        nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
        > "$evidence/initialization-$scenario.txt"
    if ! grep -q 'OK (1 test)' "$evidence/initialization-$scenario.txt"; then
        retain_wallet_failure
    fi
done
# This first-save fault needs a fresh synthetic wallet on repeated local runs.
# Clear only the .dev test app, never the signed preview or a physical phone.
[[ "$(adb get-serialno)" == emulator-* ]] || { echo 'An isolated emulator is required' >&2; exit 1; }
adb shell pm clear nl.davidengelen.redsquare.dev > "$evidence/fresh-install.txt"
grep -q Success "$evidence/fresh-install.txt"
adb shell am instrument -w -r \
    -e class nl.davidengelen.redsquare.WalletInitializationTest \
    nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
    > "$evidence/wallet-initialization-ui.txt"
if ! grep -q 'OK (1 test)' "$evidence/wallet-initialization-ui.txt"; then
    retain_wallet_failure
fi
adb shell pm clear nl.davidengelen.redsquare.dev > "$evidence/fresh-commit-sync.txt"
grep -q Success "$evidence/fresh-commit-sync.txt"
adb shell am instrument -w -r \
    -e class nl.davidengelen.redsquare.WalletCommitSyncFailureTest \
    nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
    > "$evidence/wallet-commit-sync-ui.txt"
grep -q 'OK (1 test)' "$evidence/wallet-commit-sync-ui.txt" || retain_wallet_failure
adb shell am instrument -w -r \
    -e class nl.davidengelen.redsquare.WalletPreviewTest \
    nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
    > "$evidence/wallet-ui.txt"
if ! grep -q 'OK (3 tests)' "$evidence/wallet-ui.txt"; then
    retain_wallet_failure
fi
python3 "$repo_dir/scripts/wallet-device-check" --evidence "$evidence/wallet-cold-launch"
verify_preview_update
if [[ "${TEST_PUBLIC_SIGNED_UPDATE:-0}" == 1 ]]; then
    python3 "$repo_dir/scripts/ci-review-update" 5 8 --evidence "$evidence/signed-update"
fi
adb shell am start -n nl.davidengelen.redsquare.dev/nl.davidengelen.redsquare.CompatibilityActivity
# Software emulation can briefly show a System UI boot ANR. Dismiss only that
# system dialog; an application ANR remains a failure, never a successful check.
for ((attempt=0; attempt<12; attempt++)); do
    sleep 3
    timeout 60 adb shell uiautomator dump /sdcard/redsquare-ui.xml >/dev/null || continue
    adb pull /sdcard/redsquare-ui.xml "$evidence/before.xml" >/dev/null
    action=$(python3 "$repo_dir/scripts/diagnostic-ui.py" "$evidence/before.xml")
    read -r kind x y <<< "$action"
    if [[ "$kind" == run ]]; then adb shell input tap "$x" "$y"; break; fi
    if [[ "$kind" == system-wait ]]; then adb shell input tap "$x" "$y"; fi
done
[[ "${kind:-}" == run ]] || { echo 'Diagnostic action is missing' >&2; exit 1; }
for ((attempt=0; attempt<30; attempt++)); do
    adb shell uiautomator dump /sdcard/redsquare-ui.xml >/dev/null
    adb pull /sdcard/redsquare-ui.xml "$evidence/after.xml" >/dev/null
    if grep -q 'Identity created and signature verified' "$evidence/after.xml"; then break; fi
    sleep 1
done
grep -q 'Identity created and signature verified' "$evidence/after.xml"
adb exec-out screencap -p > "$evidence/diagnostic.png"
adb shell getprop ro.build.version.sdk > "$evidence/sdk.txt"
echo "PASS: native diagnostic on Android SDK $(tr -d '\r\n' < "$evidence/sdk.txt")"
