#!/usr/bin/env bash
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
artifact="$repo_dir/app/build/outputs/apk/debug/app-debug.apk"
if [[ ! -f "$artifact" ]]; then echo 'Build the diagnostic APK first' >&2; exit 2; fi
evidence="$repo_dir/.scratch/device-evidence/api-$TEST_DEVICE_API"
mkdir -p "$evidence"
avd_home="${ANDROID_AVD_HOME:-$HOME/.android/avd}"
if [[ ! -f "$avd_home/redsquare-proof.ini" ]]; then
    printf 'no\n' | avdmanager create avd --name redsquare-proof --package "$TEST_SYSTEM_IMAGE"
fi
# The emulator's default 10 GiB data partition is unnecessary for this proof.
# Bound storage as well as RAM so a hosted runner can fit both system images.
sed -i '/^disk.dataPartition.size=/d' "$avd_home/redsquare-proof.avd/config.ini"
printf '%s\n' 'disk.dataPartition.size=2G' >> "$avd_home/redsquare-proof.avd/config.ini"
acceleration=off
[[ ! -r /dev/kvm ]] || acceleration=on
test_memory=1536
test_cores=1
if [[ "$acceleration" == on ]]; then
    # Android 17 System UI has hung under the single-core boot allocation.
    # Hosted KVM runners can give the test image two cores and 2 GiB.
    test_memory=2048
    test_cores=2
fi
emulator -avd redsquare-proof -accel "$acceleration" -no-window -no-audio -no-snapshot \
    -no-boot-anim -gpu swiftshader_indirect -feature -Vulkan -cores "$test_cores" -memory "$test_memory" \
    > "$evidence/emulator.log" 2>&1 &
emulator_pid=$!
trap 'kill "$emulator_pid" 2>/dev/null || true' EXIT
adb start-server
for ((attempt=0; attempt<120; attempt++)); do
    if [[ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" == 1 ]]; then break; fi
    if ! kill -0 "$emulator_pid" 2>/dev/null; then echo 'Emulator exited before boot' >&2; tail -30 "$evidence/emulator.log"; exit 1; fi
    sleep 5
done
[[ "$(adb shell getprop sys.boot_completed | tr -d '\r')" == 1 ]] || { echo 'Emulator boot timed out' >&2; exit 1; }
adb shell input keyevent 82
# Keep the isolated test display awake while instrumentation hands control back
# to ordinary cold launches. This does not change the installed app's behavior.
adb shell settings put system screen_off_timeout 1800000
adb shell svc power stayon true
adb shell wm dismiss-keyguard
for setting in window_animation_scale transition_animation_scale animator_duration_scale; do
    adb shell settings put global "$setting" 0
done
adb install -r "$artifact"
adb install -r "$repo_dir/app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk"
verify_browse() {
    [[ "$(adb get-serialno)" == emulator-* ]] || { echo 'An isolated emulator is required' >&2; exit 1; }
    timeout 180 adb shell am instrument -w -r \
        -e class nl.davidengelen.redsquare.ThreadProfilePreviewTest \
        nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
        > "$evidence/browse-ui.txt" || true
    adb exec-out run-as nl.davidengelen.redsquare.dev tar -C cache -cf - browse-evidence \
        > "$evidence/browse-evidence.tar" || true
    if ! grep -Eq 'OK \([1-9][0-9]* tests?\)' "$evidence/browse-ui.txt"; then
        adb exec-out screencap -p > "$evidence/browse-system-screen.png" || true
        return 1
    fi
}
if [[ "${TEST_SCOPE:-full}" == browse* ]]; then
    verify_browse
    printf '%s\n' 'Focused conversation/profile check only; full acceptance not run.' > "$evidence/scope.txt"
    exit 0
fi
