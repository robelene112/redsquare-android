        timeout 10 adb shell uiautomator dump /data/local/tmp/quote-failure.xml >/dev/null 2>&1 || true
        adb pull /data/local/tmp/quote-failure.xml "$evidence/quote-system-window.xml" >/dev/null 2>&1 || true
        return 1
    fi
    python3 "$repo_dir/scripts/post-process-check" --quote --evidence "$evidence/quote-process"
}
if [[ "${TEST_SCOPE:-full}" == quotes* ]]; then
