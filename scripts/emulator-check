    verify_images
    printf '%s\n' 'Focused image check only; full acceptance not run.' > "$evidence/scope.txt"
    exit 0
fi
verify_videos() {
    [[ "$(adb get-serialno)" == emulator-* ]] || { echo 'An isolated emulator is required' >&2; exit 1; }
    local video_class=nl.davidengelen.redsquare.VideoPreviewTest
    local public_video_read=0
    if [[ "${TEST_SCOPE:-full}" == video-public* ]]; then
        video_class=nl.davidengelen.redsquare.PublicYouTubeReadTest
        public_video_read=1
    fi
    adb shell dumpsys webviewupdate > "$evidence/video-webview.txt"
    adb logcat -c
    local video_diagnostic_pid=
    if [[ "$public_video_read" == 1 ]]; then
        timeout 150 node "$repo_dir/build-support/video-browser-diagnostics.cjs" "$evidence" --provider-error \
            > "$evidence/video-browser-tool.txt" 2>&1 &
        video_diagnostic_pid=$!
    fi
    timeout 180 adb shell am instrument -w -r \
        -e class "$video_class" -e publicVideoRead "$public_video_read" \
        -e publicVideoReference "${TEST_PUBLIC_VIDEO_REFERENCE:-0}" \
        nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
        > "$evidence/video-ui.txt" || true
    if [[ -n "$video_diagnostic_pid" ]]; then
        kill "$video_diagnostic_pid" 2>/dev/null || true
        wait "$video_diagnostic_pid" || true
    fi
    adb logcat -d -v brief RedSquareVideo:W '*:S' > "$evidence/video-status.txt"
    adb exec-out screencap -p > "$evidence/video-last-window.png" || true
    adb exec-out run-as nl.davidengelen.redsquare.dev tar -C cache -cf - video-evidence \
        > "$evidence/video-evidence.tar" || true
    grep -Eq 'OK \([1-9][0-9]* tests?\)' "$evidence/video-ui.txt"
}
if [[ "${TEST_SCOPE:-full}" == videos* || "${TEST_SCOPE:-full}" == video-public* ]]; then
