        > "$evidence/personal-controls-evidence.tar" || true
    if ! grep -Eq 'OK \([1-9][0-9]* tests?\)' "$evidence/personal-controls-ui.txt"; then
        adb exec-out screencap -p > "$evidence/personal-controls-system-screen.png" || true
        return 1
    fi
    python3 "$repo_dir/scripts/personal-controls-process-check" --evidence "$evidence/personal-controls-process"
}
