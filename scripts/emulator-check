    grep -q 'OK (1 test)' "$evidence/wallet-backup-ui.txt"
}
if [[ "${TEST_SCOPE:-full}" == export* ]]; then
    verify_wallet_export
    verify_wallet_backup_reminder
    printf '%s\n' 'Focused wallet-export check only; full feed/wallet/update acceptance not run.' > "$evidence/scope.txt"
    exit 0
fi
if [[ "${TEST_SCOPE:-full}" == full ]]; then
    verify_wallet_export
    verify_wallet_backup_reminder
    verify_wallet_import
    verify_wallet_storage_recovery
fi
