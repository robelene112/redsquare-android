    [[ "$(adb get-serialno)" == emulator-* ]] || { echo 'An isolated emulator is required' >&2; exit 1; }
    timeout 180 adb shell am instrument -w -r \
        -e class nl.davidengelen.redsquare.FollowingPreviewTest \
