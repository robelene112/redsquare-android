#!/usr/bin/env bash
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
tools_dir="$repo_dir/.scratch/ci-sdk-tools"
mkdir -p "$tools_dir"
curl --fail --location --retry 3 --retry-all-errors --retry-delay 2 --connect-timeout 30 --max-time 300 \
    https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip \
    -o "$tools_dir/tools.zip"
printf '%s  %s\n' 4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583 "$tools_dir/tools.zip" | sha256sum -c -
unzip -q "$tools_dir/tools.zip" -d "$tools_dir"
installed_tools="$ANDROID_HOME/cmdline-tools/redsquare-15859902"
mkdir -p "$ANDROID_HOME/cmdline-tools"
mv "$tools_dir/cmdline-tools" "$installed_tools"
printf '%s\n' "$installed_tools/bin" >> "$GITHUB_PATH"
"$installed_tools/bin/sdkmanager" --sdk_root="$ANDROID_HOME" \
    'platforms;android-36' 'build-tools;35.0.0' 'emulator'
