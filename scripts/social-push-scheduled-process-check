#!/usr/bin/env python3
"""Observe a persisted social receipt after app death, without relaunching the target."""
import argparse
import json
from pathlib import Path
import re
import subprocess
import time
import xml.etree.ElementTree as ET
from process_check_utils import ProcessInstrumentation, assert_process_gone, finish_process_fixture

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--evidence', type=Path, required=True)
args = parser.parse_args()
repo = Path(__file__).resolve().parent.parent
package = 'nl.davidengelen.redsquare.dev'
runner = package + '.test/androidx.test.runner.AndroidJUnitRunner'
checkpoint = 'cache/social-push-scheduled-checkpoint.json'
args.evidence.mkdir(parents=True, exist_ok=True)
control = args.evidence / 'host-peer'
control.mkdir()


def adb(*arguments, check=True, timeout=30):
    return subprocess.run(['adb', *arguments], capture_output=True, text=True, check=check, timeout=timeout)


def write_control(name, value):
    temporary = control / (name + '.new')
    temporary.write_text(value)
    temporary.replace(control / name)


def wait_for(label, observe, seconds, process=None):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if process is not None and process.poll() is not None:
            raise AssertionError(label + ': owned process exited early')
        result = observe()
        if result:
            return result
        time.sleep(.2)
    raise AssertionError(label + ': deadline exceeded')


def public_checkpoint():
    result = adb('exec-out', 'run-as', package, 'cat', checkpoint, check=False)
    if result.returncode:
        return None
    try:
        row = json.loads(result.stdout)
    except json.JSONDecodeError:
        # API29 AtomicFile exposes its base during a valid write. Keep the existing deadline.
        return None
    return row if row['phase'] == 'pending' else None


def target_pids():
    result = adb('shell', 'pidof', package, check=False)
    if result.returncode not in (0, 1):
        raise AssertionError('Cannot observe target process')
    return [int(value) for value in result.stdout.split()]


if not adb('get-serialno').stdout.strip().startswith('emulator-'):
    raise SystemExit('An isolated emulator is required')
classpath = (repo / 'core/build/host-peer-classpath.txt').read_text().strip()
write_control('mode', 'unavailable')
primary = None
host = setup = None
mapping = None
instrument = ProcessInstrumentation(adb, args.evidence,
    'nl.davidengelen.redsquare.SocialPushScheduledProcessTest', runner).run
with (control / 'host.log').open('w') as host_log, (args.evidence / 'interrupted.txt').open('w') as setup_log:
    try:
        host = subprocess.Popen(['java', '-cp', classpath, 'nl.davidengelen.redsquare.HostArchivePeer',
            str(control.resolve()), str(repo / 'app/src/androidTest/assets/native-notification-reference.json')],
            stdout=host_log, stderr=subprocess.STDOUT)
        ready = wait_for('Host peer readiness', lambda: json.loads((control / 'ready.json').read_text())
            if (control / 'ready.json').exists() else None, 20, host)
        port = ready['port']
        if not isinstance(port, int) or not 1024 <= port <= 65535:
            raise AssertionError('Invalid owned peer port')
        candidate = 'tcp:' + str(port)
        adb('reverse', '--no-rebind', candidate, candidate)
        mapping = candidate  # Ownership starts only after no-rebind succeeded.
        mappings = adb('reverse', '--list').stdout
        (args.evidence / 'reverse-before.txt').write_text(mappings)
        if not any(line.split()[-2:] == [mapping, mapping] for line in mappings.splitlines()):
            raise AssertionError('Owned reverse mapping is absent')
        setup = subprocess.Popen(['adb', 'shell', 'am', 'instrument', '-w', '-r', '-e', 'class',
            'nl.davidengelen.redsquare.SocialPushScheduledProcessTest#holdPendingReceiptUntilTheHostTerminatesThisProcess',
            '-e', 'hostPeerPort', str(port), runner], stdout=setup_log, stderr=subprocess.STDOUT)
        row = wait_for('Persisted retry checkpoint', public_checkpoint, 75, setup)
        pid = row['pid']
        if not isinstance(pid, int) or pid <= 0 or row['port'] != port or pid not in target_pids():
            raise AssertionError('Pending checkpoint does not identify the live target')
        if row['backend'] != 'owner' or not re.fullmatch(r'[1-9A-HJ-NP-Za-km-z]{43,45}', row['owner']):
            raise AssertionError('Invalid public receipt owner/backend')
        signature = row['reply']['sig']
        if not re.fullmatch(r'[0-9a-f]{128}', signature) or row['tag'] != f"social:{row['owner']}:owner:{signature}":
            raise AssertionError('Invalid exact notification identity')
        (args.evidence / 'pending-checkpoint.json').write_text(json.dumps(row, indent=2) + '\n')
        adb('shell', 'run-as', package, 'kill', '-9', str(pid))
        assert_process_gone(adb, package, pid)
        setup.wait(timeout=15)
        setup_log.flush()
        interrupted = (args.evidence / 'interrupted.txt').read_text()
        if 'Process crashed.' not in interrupted or 'FAILURES!!!' in interrupted:
            raise AssertionError('Pending instrumentation did not end at the deliberate process kill')
        # Read after death so any accepted recovery must include a new peer request.
        before = json.loads((control / 'observed.json').read_text())
        write_control('reply.json', json.dumps(row['reply']))
        write_control('mode', 'available')

        def recovered_alert():
            pids = target_pids()
            if pid in pids:
                raise AssertionError('Original PID unexpectedly still exists')
            observed = json.loads((control / 'observed.json').read_text())
            # available mode is enabled only after death, avoiding a stale-counter baseline.
            if not pids or observed['availableReads'] < 2:
                return None
            dump = adb('shell', 'dumpsys', 'notification', '--noredact').stdout
            records = re.split(r'(?=NotificationRecord\()', dump)
            if not any('pkg=' + package in record.split('\n', 1)[0] and
                       'tag=' + row['tag'] in record.split('\n', 1)[0] and
                       'Replied to your post' in record for record in records):
                return None
            return {'oldPid': pid, 'recoveredPids': pids, 'peerBefore': before, 'peerAfter': observed}, dump

        result, dump = wait_for('Autonomous OS restart and exact Android alert', recovered_alert, 120, host)
        (args.evidence / 'recovered-observation.json').write_text(json.dumps(result, indent=2) + '\n')
        (args.evidence / 'notification-after.txt').write_text(dump)
        activities = adb('shell', 'dumpsys', 'activity', 'activities').stdout
        (args.evidence / 'activities-after.txt').write_text(activities)
        if any(package + '/' in line and 'MainActivity' in line for line in activities.splitlines()
               if 'ActivityRecord{' in line):
            raise AssertionError('A target Activity appeared during autonomous recovery')
        adb('shell', 'cmd', 'statusbar', 'expand-notifications')
        adb('shell', 'uiautomator', 'dump', '/sdcard/redsquare-scheduled-alert.xml')
        adb('pull', '/sdcard/redsquare-scheduled-alert.xml', str(args.evidence / 'autonomous-alert.xml'))
        nodes = list(ET.parse(args.evidence / 'autonomous-alert.xml').iter('node'))
        if not any(node.get('text') == 'Replied to your post' for node in nodes):
            raise AssertionError('The actual system shade did not display the recovered reply alert')
        with (args.evidence / 'autonomous-alert.png').open('wb') as output:
            subprocess.run(['adb', 'exec-out', 'screencap', '-p'], stdout=output, check=True, timeout=15)
    except BaseException as failure:
        primary = failure
        raise
    finally:
        # Cleanup is after observation. No force-stop, instrumentation or forced job occurs during it.
        cleanup_failures = []
        try:
            adb('shell', 'am', 'force-stop', package)
        except BaseException as failure:
            cleanup_failures.append(failure)
        try:
            if setup is not None and setup.poll() is None:
                try:
                    setup.wait(timeout=15)
                except subprocess.TimeoutExpired as failure:
                    cleanup_failures.append(failure)
                    setup.terminate()
                    try:
                        setup.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        setup.kill()
                        setup.wait(timeout=5)
        except BaseException as failure:
            cleanup_failures.append(failure)
        try:
            if target_pids():
                raise AssertionError('Target remained live before independent restoration')
            finish_process_fixture(instrument, args.evidence, package, 'social-push-scheduled-evidence', primary)
        except BaseException as failure:
            cleanup_failures.append(failure)
        if mapping is not None:
            try:
                adb('reverse', '--remove', mapping)
                (args.evidence / 'reverse-after.txt').write_text(adb('reverse', '--list').stdout)
            except BaseException as failure:
                cleanup_failures.append(failure)
        if host is not None:
            try:
                write_control('mode', 'stop')
                if host.wait(timeout=10) != 0:
                    raise AssertionError('Host fixture rejected the observed journey; see host.log')
            except BaseException as failure:
                cleanup_failures.append(failure)
                try:
                    host.kill()
                    host.wait(timeout=10)
                except BaseException as fallback_failure:
                    cleanup_failures.append(fallback_failure)
        if cleanup_failures:
            if primary is None:
                for failure in cleanup_failures[1:]:
                    cleanup_failures[0].add_note('Cleanup also failed: ' + str(failure))
                raise cleanup_failures[0]
            for failure in cleanup_failures:
                primary.add_note('Cleanup also failed: ' + str(failure))

(args.evidence / 'continuity.txt').write_text(
    'PASS: pending receipt, verified live PID killed, different process and post-death Archive reads, '
    'exact system reply alert without target instrumentation/Activity/forced jobs during observation; '
    'owned work cancelled and original device-only installation restored. Local scheduling, not FCM.\n')
