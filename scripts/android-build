#!/usr/bin/env bash
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
# The bounded VPS cannot keep JVM test workers beside the large app compiler.
# Fail before provisioning rather than losing the Gradle daemon to the cgroup.
has_jvm_tests=false
has_app_build=false
for task_argument in "$@"; do
    if [[ "$task_argument" == :core:test || "$task_argument" == :spaces-service:test ]]; then has_jvm_tests=true; fi
    if [[ "$task_argument" == :app:compile* || "$task_argument" == :app:assemble* || "$task_argument" == :app:bundle* ]]; then has_app_build=true; fi
done
if [[ "$has_jvm_tests" == true && "$has_app_build" == true ]]; then
    printf '%s\n' 'Run core/service tests and Android compilation in separate android-build invocations on this bounded VPS.' >&2
    exit 64
fi
image=redsquare-android-build:agp8.10.1
if ! docker image inspect "$image" >/dev/null 2>&1; then
    docker build --memory=2g -t "$image" "$repo_dir/build-support"
fi
# Keep the vendored editor compiler lifetime separate from the app compiler in
# this bounded local container. Hosted CI retains its existing complete task graph.
warm_debug=false
warm_release=false
warm_app_debug=false
for task_argument in "$@"; do
    if [[ "$task_argument" == :app:*Debug* ]]; then warm_debug=true; fi
    if [[ "$task_argument" == :app:*DebugAndroidTest* ]]; then warm_app_debug=true; fi
    if [[ "$task_argument" == :app:*Release* || "$task_argument" == :app:*Performance* ]]; then warm_release=true; fi
done
if [[ "$warm_app_debug" == true ]]; then
    # Keep the large main and instrumentation compiler lifetimes separate in
    # this bounded VPS container. Native goals and hosted CI remain unchanged.
    "$repo_dir/scripts/android-build" :app:compileDebugKotlin
elif [[ "$warm_debug" == true ]]; then
    "$repo_dir/scripts/android-build" :rich-editor-compat:compileDebugKotlin
fi
if [[ "$warm_release" == true ]]; then "$repo_dir/scripts/android-build" :rich-editor-compat:compileReleaseKotlin; fi
cache_dir="$repo_dir/.scratch/gradle-cache"
mkdir -p "$cache_dir"
# Gradle cannot coordinate identical container PIDs across separate namespaces.
# Serialize its shared cache after recursive warmups, so those cannot deadlock.
exec 9> "$cache_dir/.redsquare-android-build.lock"
flock 9
docker run --rm --cpus=2 --memory=2500m \
    --user "$(id -u):$(id -g)" \
    -e GRADLE_USER_HOME=/gradle-cache -e ANDROID_USER_HOME=/gradle-cache/android-user \
    --mount "type=bind,src=$repo_dir,dst=/workspace" \
    --mount "type=bind,src=$cache_dir,dst=/gradle-cache" \
    "$image" gradle --no-daemon --console=plain "$@"
