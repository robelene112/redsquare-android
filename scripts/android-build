#!/usr/bin/env bash
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
image=redsquare-android-build:agp8.10.1
if ! docker image inspect "$image" >/dev/null 2>&1; then
    docker build --memory=2g -t "$image" "$repo_dir/build-support"
fi
cache_dir="$repo_dir/.scratch/gradle-cache"
mkdir -p "$cache_dir"
docker run --rm --cpus=2 --memory=2500m \
    --user "$(id -u):$(id -g)" \
    -e GRADLE_USER_HOME=/gradle-cache \
    --mount "type=bind,src=$repo_dir,dst=/workspace" \
    --mount "type=bind,src=$cache_dir,dst=/gradle-cache" \
    "$image" gradle --no-daemon --console=plain "$@"
