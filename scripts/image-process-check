#!/usr/bin/env python3
"""Recover a prepared image without its source, then reconcile its exact signed candidate."""
import argparse
import json
from pathlib import Path
import re
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--evidence', type=Path, required=True)
args = parser.parse_args()
package = 'nl.davidengelen.redsquare.dev'
runner = package + '.test/androidx.test.runner.AndroidJUnitRunner'
test_class = 'nl.davidengelen.redsquare.ImageProcessRecoveryTest'
checkpoint = 'cache/image-process-checkpoint.json'


def adb(*arguments, check=True, timeout=60):
    return subprocess.run(['adb', *arguments], capture_output=True, text=True, check=check, timeout=timeout)


if not adb('get-serialno').stdout.strip().startswith('emulator-'):
    raise SystemExit('This process check requires an isolated emulator')
args.evidence.mkdir(parents=True, exist_ok=True)
adb('shell', 'run-as', package, 'rm', '-f', checkpoint)
def instrument(name, log_name, check=True):
    try:
        result = adb('shell', 'am', 'instrument', '-w', '-r', '-e', 'class',
                     test_class + '#' + name, runner, check=check, timeout=120)
        (args.evidence / log_name).write_text(result.stdout + result.stderr)
        return result
    except (subprocess.TimeoutExpired, subprocess.CalledProcessError) as error:
        def decoded(value):
            return value.decode('utf-8', errors='replace') if isinstance(value, bytes) else (value or '')
        (args.evidence / log_name).write_text(decoded(error.stdout) + decoded(error.stderr))
        raise


try:
    for name, expected in [('terminateWithDurableImageDraftAfterDeletingItsSource', 'draft'),
                           ('coldDraftKeepsPixelsWithoutSourceAndTerminatesAfterUncertainSend', 'candidate')]:
        result = instrument(name, expected + '-interrupted.txt', check=False)
        if 'FAILURES!!!' in result.stdout:
            raise AssertionError('Image phase failed before deliberate termination: ' + name)
        row = json.loads(adb('exec-out', 'run-as', package, 'cat', checkpoint).stdout)
        if row['phase'] != expected:
            raise AssertionError('Missing current image checkpoint')
        if str(row['pid']) in adb('shell', 'pidof', package, check=False).stdout.split():
            raise AssertionError('Image process was not actually terminated')
        if expected == 'candidate' and not re.fullmatch(r'[0-9a-f]{128}', row['sig']):
            raise AssertionError('Image candidate signature is invalid')
        adb('shell', 'am', 'force-stop', package)
    result = instrument('coldCandidateReconcilesWithoutRebroadcastingOrLosingItsImage',
                        'recovered-instrumentation.txt')
    if 'OK (1 test)' not in result.stdout:
        raise AssertionError('Cold image candidate reconciliation did not pass')
    (args.evidence / 'continuity.txt').write_text(
        'PASS: two actual process deaths; prepared image recovers after source deletion; '
        'cold signed candidate reconciles without another broadcast and then clears.\n')
    print('PASS: image draft and candidate process recovery')
finally:
    # Capture every phase failure before the isolated emulator is torn down.
    # Best effort capture cannot replace the original runtime failure.
    try:
        with (args.evidence / 'images.tar').open('wb') as output:
            captured = subprocess.run(['adb', 'exec-out', 'run-as', package, 'tar', '-C', 'cache',
                                      '-cf', '-', 'image-process-evidence'], stdout=output,
                                     stderr=subprocess.PIPE, timeout=10)
        (args.evidence / 'capture-status.txt').write_text(str(captured.returncode) + '\n' +
                                                       captured.stderr.decode('utf-8', errors='replace'))
    except (OSError, subprocess.TimeoutExpired) as failure:
        (args.evidence / 'capture-status.txt').write_text('Synthetic evidence capture failed: ' + str(failure))
