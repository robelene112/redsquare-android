+// Echo the identity of the saved original, never the current retry's payload.
+function storedPurchaseSignature(payload) {
+  try {
+    const envelope = JSON.parse(payload || '{}');
+    const bytes = Buffer.from(envelope.t || '', 'base64');
+    return bytes.length >= 93 ? bytes.subarray(16, 80).toString('hex') : '';
+  } catch (err) {
+    return '';
+  }
+}
