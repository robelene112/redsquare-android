+/** Metadata-only restoration, authorised by the actual current loan and provider NOW. */
+async function receiveRestoreRentalTransaction(tx, callback) {
+  try {
+    const creator = String(tx?.from?.[0]?.publicKey || tx?.from?.[0]?.public_key || '');
+    const data = tx.returnMessage()?.data || {};
+    const fileId = String(data.file_id || '');
+    const renter = String(data.renter || '');
+    const expiry = data.expires_at;
+    if (!creator || !/^[0-9a-f]{128}$/.test(fileId) || !renter || renter.length > 128 ||
+        !Number.isSafeInteger(expiry) || expiry < 0 || !this.app.core?.scripting?.hash) {
+      callback({status: 'err', err: 'invalid_rental_restore'}); return 1;
+    }
+    const master = JSON.stringify(rental.build({creator_publickey: creator}));
+    const masterHash = this.app.core.scripting.hash(master);
+    const priorLoan = JSON.stringify(loan.instantiate({creator_publickey: creator, renter_publickey: renter, expires_at: expiry}));
+    const loanHash = this.app.core.scripting.hash(priorLoan);
+    const rows = await this.app.storage.queryDatabase('SELECT sig, owner FROM archives WHERE sig = $sig', {$sig: fileId}, 'archive');
+    if (!rows || rows.length !== 1) {
+      callback({status: 'err', err: 'rental_file_unavailable', file_id: fileId}); return 1;
+    }
+    if (rows[0].owner === masterHash) {
+      callback({status: 'ok', file_id: fileId, owner: masterHash, already_restored: true}); return 1;
+    }
+    if (rows[0].owner !== loanHash) {
+      callback({status: 'err', err: 'rental_owner_changed', file_id: fileId}); return 1;
+    }
+    // Archive authenticates the stored owner and actual request actor/NOW. No client-clock grant.
+    const changed = await this.app.storage.updateTransaction(null,
+      {sig: fileId, owner: masterHash, expected_owner: loanHash, access_script: priorLoan, request_tx: tx}, 'localhost');
+    callback(changed ? {status: 'ok', file_id: fileId, owner: masterHash, already_restored: false}
+      : {status: 'err', err: 'rental_restore_denied', file_id: fileId});
+  } catch (error) {
+    callback({status: 'err', err: String(error?.message || error)});
+  }
+  return 1;
+}
+
 module.exports = {
+  receiveRestoreRentalTransaction,
   createCheckOutRentalTransaction,
   receiveCheckOutRentalTransaction
 };
