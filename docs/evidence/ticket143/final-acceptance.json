  "acceptanceMap": [
    {
      "requirement": "Native file library with explicit downloads",
      "results": "The actual system document picker supplies a PNG. The accepted row displays its name, sender, size and date. Opening the list and its detail leaves the native download count at zero. Keeping an offline copy retrieves the payload once."
    },
    {
      "requirement": "Explicit provider terms, capacity, renewal and no file bytes on the node",
      "results": "The Android owner enters an independent HTTPS origin and reviews the exact signed terms before confirming. The operator process retains ciphertext and reports quota. The app shows full capacity, a forced provider outage, approaching expiry, current expiry and owner-confirmed renewal."
    },
    {
      "requirement": "Byte-exact recovery and distinct removal effects",
      "results": "A second identity downloads the original after the uploader is force-stopped and the operator restarts. While the operator is stopped, a separate Android viewer opens the real read grant, seeks and verifies the same SHA-256. Removing the offline copy leaves the quota unchanged. Confirmed shared removal clears the published entry and frees its provider capacity."
    },
    {
      "requirement": "Scoped authorization and private metadata",
      "results": "Independent service tests exercise archived channel uploads and departed-member downloads while bytes are in flight, exact staged upload recovery after renewal, approved owner terms and signed expiry, and ciphertext length padding. The provider rechecks committed authorization during transfer. File keys, original size, name, MIME and sender remain in the protected Space descriptor for private channels."
    }
  ],
