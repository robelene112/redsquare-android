+if [[ "${TEST_SCOPE:-full}" == chat-runtime ]]; then
+    [[ "$TEST_DEVICE_API" == 29 && "$(adb get-serialno)" == emulator-* ]] || exit 2
+    printf '%s\n' 'Temporary process-startup diagnosis only; no complete application acceptance.' > "$evidence/scope.txt"
+    adb shell getprop ro.zygote > "$evidence/runtime-zygote-kind.txt"
+    for property in dalvik.vm.heapstartsize dalvik.vm.heapgrowthlimit dalvik.vm.heapsize ro.kernel.qemu.dalvik.vm.heapsize; do
+        printf '%s=' "$property"
+        adb shell getprop "$property" | tr -d '\r'
+    done > "$evidence/runtime-properties.txt"
+    timeout 10 adb shell cat /vendor/etc/init/hw/init.ranchu.rc > "$evidence/runtime-init-ranchu.txt" 2>&1 || true
+    adb shell ps -A -o PID,PPID,NAME > "$evidence/runtime-processes-before.txt"
+    for ((runtime_attempt=1; runtime_attempt<=24; runtime_attempt++)); do
+        runtime_exit=0
+        timeout 30 adb shell am instrument -w -r -e class nl.davidengelen.redsquare.ChatRuntimeDiagnosticTest \
+            nl.davidengelen.redsquare.dev.test/androidx.test.runner.AndroidJUnitRunner \
+            > "$evidence/runtime-$runtime_attempt.txt" || runtime_exit=$?
+        printf '%s\n' "$runtime_exit" > "$evidence/runtime-$runtime_attempt-exit.txt"
+        adb shell ps -A -o PID,PPID,NAME > "$evidence/runtime-processes-$runtime_attempt.txt"
+        [[ "$runtime_exit" == 0 ]] && grep -q 'OK (1 test)' "$evidence/runtime-$runtime_attempt.txt" || exit 1
+    done
+    exit 0
+fi
