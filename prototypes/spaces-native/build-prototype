#!/usr/bin/env bash
# Build/sign the isolated prototype. Never publishes or modifies the ordinary beta.
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "$0")/../.." && pwd)
artifact_dir=/home/david/.cache/redsquare-android-artifacts/spaces-planning-20261117/signed-prototype1
cache_dir=/mnt/storage/redsquare-android-artifacts/redesign-build-cache
signing_dir="$HOME/.local/share/redsquare-android/signing"
[[ -z "$(git -C "$repo_dir" status --porcelain --untracked-files=no)" ]] || { echo 'Commit the reviewed source before signing'; exit 1; }
source_commit=$(git -C "$repo_dir" rev-parse HEAD)
mkdir -p "$artifact_dir"
docker run --rm --cpus=2 --memory=2500m --user "$(id -u):$(id -g)" -e GRADLE_USER_HOME=/gradle-cache \
 --mount "type=bind,src=$repo_dir,dst=/workspace" --mount "type=bind,src=$cache_dir,dst=/gradle-cache" \
 redsquare-android-build:agp8.10.1 gradle --no-daemon --console=plain -p prototypes/spaces-native :assembleRelease :lintRelease
[[ "$source_commit" == "$(git -C "$repo_dir" rev-parse HEAD)" && -z "$(git -C "$repo_dir" status --porcelain --untracked-files=no)" ]] || { echo "Source changed during compilation; do not sign this artifact"; exit 1; }
input_apk=$(python3 - "$repo_dir" <<'PY'
import json,pathlib,sys
p=pathlib.Path(sys.argv[1])/'prototypes/spaces-native/build/outputs/apk/release'
m=json.loads((p/'output-metadata.json').read_text()); assert len(m['elements'])==1
assert m['applicationId']=='nl.davidengelen.redsquare.spaces.prototype'
print('/workspace/prototypes/spaces-native/build/outputs/apk/release/'+m['elements'][0]['outputFile'])
PY
)
docker run --rm --user "$(id -u):$(id -g)" --env-file "$signing_dir/signing.env" \
 --mount "type=bind,src=$signing_dir,dst=/signing,readonly" --mount "type=bind,src=$repo_dir,dst=/workspace,readonly" \
 --mount "type=bind,src=$artifact_dir,dst=/artifacts" redsquare-android-build:agp8.10.1 \
 /opt/android-sdk/build-tools/35.0.0/apksigner sign --ks /signing/app-signing.p12 --ks-key-alias app-signing \
 --ks-pass env:REDSQUARE_STORE_PASSWORD --key-pass env:REDSQUARE_KEY_PASSWORD --out /artifacts/spaces-prototype.apk "$input_apk"
for check in signature manifest; do
 if [[ "$check" == signature ]]; then command=(/opt/android-sdk/build-tools/35.0.0/apksigner verify --print-certs /artifacts/spaces-prototype.apk); else command=(apkanalyzer manifest print /artifacts/spaces-prototype.apk); fi
 docker run --rm --user "$(id -u):$(id -g)" --mount "type=bind,src=$artifact_dir,dst=/artifacts,readonly" redsquare-android-build:agp8.10.1 "${command[@]}" > "$artifact_dir/$check.txt"
done
python3 - "$artifact_dir" "$repo_dir" <<'PY'
import hashlib,json,pathlib,re,subprocess,sys,xml.etree.ElementTree as ET
p=pathlib.Path(sys.argv[1]); root=ET.fromstring((p/'manifest.txt').read_text()); a='{http://schemas.android.com/apk/res/android}'
assert root.get('package')=='nl.davidengelen.redsquare.spaces.prototype'
internal=root.get('package')+'.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION'
assert all(e.get(a+'name')==internal for e in root.findall('uses-permission')), 'No device/network permissions allowed'
assert any(e.get(a+'name')==internal and e.get(a+'protectionLevel')=='signature' for e in root.findall('permission')), 'Require the AndroidX signature-only receiver guard'
assert root.find('application').get(a+'debuggable','false')=='false'
cert=re.search(r'certificate SHA-256 digest: ([0-9a-f]+)',(p/'signature.txt').read_text())[1]
assert cert==(pathlib.Path.home()/'.local/share/redsquare-android/review/certificate.sha256').read_text().strip()
metadata={'applicationId':root.get('package'),'versionCode':int(root.get(a+'versionCode')),'versionName':root.get(a+'versionName'),'sourceCommit':subprocess.check_output(['git','-C',sys.argv[2],'rev-parse','HEAD'],text=True).strip(),'sha256':hashlib.sha256((p/'spaces-prototype.apk').read_bytes()).hexdigest(),'bytes':(p/'spaces-prototype.apk').stat().st_size,'certificateSha256':cert,'syntheticData':True,'ordinaryBetaChanged':False}
(p/'manifest.json').write_text(json.dumps(metadata,indent=2)+'\n')
print(json.dumps(metadata,indent=2))
PY
